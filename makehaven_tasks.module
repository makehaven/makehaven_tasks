<?php

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;

/**
 * Implements hook_entity_insert().
 */
function makehaven_tasks_entity_insert(EntityInterface $entity) {
  if ($entity->getEntityTypeId() === 'flagging' && $entity->getFlagId() === 'task_completed') {
    _makehaven_tasks_notify_slack($entity);
    _makehaven_tasks_schedule_next_occurrence($entity);
  }
}

/**
 * Implements hook_entity_view().
 */
function makehaven_tasks_entity_view(array &$build, EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display, $view_mode) {
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'task' || $view_mode !== 'default') {
    return;
  }

  $build['#attached']['library'][] = 'makehaven_tasks/dashboard';

  // Read status fields.
  $task_status = 'open';
  if ($entity->hasField('field_task_status') && !$entity->get('field_task_status')->isEmpty()) {
    $task_status = (string) $entity->get('field_task_status')->value;
  }

  $claimed_by_name = '';
  if ($entity->hasField('field_task_claimed_by') && !$entity->get('field_task_claimed_by')->isEmpty()) {
    $claimed_user = $entity->get('field_task_claimed_by')->entity;
    if ($claimed_user) {
      $claimed_by_name = $claimed_user->getDisplayName();
    }
  }

  $handoff_note_text = '';
  if ($entity->hasField('field_task_handoff_note') && !$entity->get('field_task_handoff_note')->isEmpty()) {
    $handoff_note_text = (string) $entity->get('field_task_handoff_note')->value;
  }

  // Build status notice.
  $status_notice = [];
  if ($task_status === 'in_progress' && $claimed_by_name !== '') {
    $status_notice = [
      '#type' => 'html_tag',
      '#tag' => 'div',
      '#attributes' => ['class' => ['task-status-notice', 'task-status-notice--in-progress']],
      '#value' => '⚙ ' . \Drupal\Component\Utility\Html::escape($claimed_by_name) . ' is working on this.',
    ];
  }
  elseif ($task_status === 'incomplete') {
    $notice_inner = '';
    if ($claimed_by_name !== '') {
      $notice_inner .= '⚠ ' . \Drupal\Component\Utility\Html::escape($claimed_by_name) . ' started this but couldn\'t finish.';
    }
    else {
      $notice_inner .= '⚠ Someone started this but couldn\'t finish.';
    }
    if ($handoff_note_text !== '') {
      $notice_inner .= '<div class="task-status-notice__note">' . nl2br(\Drupal\Component\Utility\Html::escape($handoff_note_text)) . '</div>';
    }
    $status_notice = [
      '#type' => 'html_tag',
      '#tag' => 'div',
      '#attributes' => ['class' => ['task-status-notice', 'task-status-notice--incomplete']],
      '#value' => $notice_inner,
    ];
  }

  // Build primary buttons container.
  $current_user = \Drupal::currentUser();
  $buttons = [
    '#type' => 'container',
    '#attributes' => ['class' => ['makehaven-task-actions__buttons']],
  ];

  if ($current_user->isAuthenticated()) {
    $buttons['complete'] = \Drupal::service('flag.link_builder')->build('node', (int) $entity->id(), 'task_completed', 'full');
  }
  else {
    $buttons['login'] = [
      '#type' => 'link',
      '#title' => t('Log in to mark done'),
      '#url' => Url::fromRoute('user.login'),
      '#options' => ['attributes' => ['class' => ['button']]],
    ];
  }

  // Build instructions and recurring-series buttons.
  $instructions = t('Read the instructions, do the work safely, leave a comment if context would help the next person, then mark the task done here.');
  if ($entity->hasField('field_task_required_badge') && !$entity->get('field_task_required_badge')->isEmpty()) {
    $badge = $entity->get('field_task_required_badge')->entity;
    if ($badge) {
      $instructions = t('This task requires the %badge badge. If you are qualified, do the work safely and then mark the task done here.', ['%badge' => $badge->label()]);
    }
  }

  $series_source = _makehaven_tasks_get_series_source($entity);
  $is_recurring = $series_source->hasField('field_task_frequency')
    && !$series_source->get('field_task_frequency')->isEmpty()
    && !in_array((string) $series_source->get('field_task_frequency')->value, ['once', 'occasional', 'archive'], TRUE);

  $series_buttons = [];
  if ($is_recurring) {
    $series_buttons['defer'] = [
      '#type' => 'link',
      '#title' => t('Defer this occurrence'),
      '#url' => $entity->toUrl('edit-form'),
      '#options' => ['attributes' => ['class' => ['button']]],
    ];

    if ((int) $series_source->id() !== (int) $entity->id()) {
      $series_buttons['series'] = [
        '#type' => 'link',
        '#title' => t('Manage recurring series'),
        '#url' => $series_source->toUrl('edit-form'),
        '#options' => ['attributes' => ['class' => ['button']]],
      ];
      $instructions = t('This task is one occurrence in a recurring series. To defer just this copy, edit this task and move Next due later. To pause or stop future copies, open Manage recurring series.');
    }
    else {
      $series_buttons['series'] = [
        '#type' => 'link',
        '#title' => t('Manage recurring series'),
        '#url' => $entity->toUrl('edit-form'),
        '#options' => ['attributes' => ['class' => ['button']]],
      ];
      $instructions = t('This task is the source for a recurring series. To stop future copies, pause the series or change the frequency. To defer the current copy, move Next due later and unpublish it.');
    }
  }

  // Build the "More options" details element for authenticated users.
  $more_options = [];
  if ($current_user->isAuthenticated()) {
    $claim_url = Url::fromRoute('makehaven_tasks.claim', ['node' => $entity->id()]);
    $token = \Drupal::csrfToken()->get($claim_url->getInternalPath());
    $claim_url->mergeOptions(['query' => ['token' => $token]]);

    $handoff_url = Url::fromRoute('makehaven_tasks.handoff', ['node' => $entity->id()]);

    $more_links_html = '<div class="task-actions__more-buttons">'
      . '<a href="' . $claim_url->toString() . '" class="button">' . t("I'm working on this") . '</a>'
      . '<a href="' . $handoff_url->toString() . '" class="button">' . t("I couldn't finish — hand off") . '</a>'
      . '</div>';

    $more_options = [
      '#type' => 'container',
      'details' => [
        '#markup' => '<details class="task-actions__more"><summary>' . t('More options') . '</summary>' . $more_links_html . '</details>',
      ],
    ];
  }

  $build['makehaven_task_actions'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['makehaven-task-actions']],
    '#weight' => -20,
    'title' => [
      '#type' => 'html_tag',
      '#tag' => 'h2',
      '#value' => t('What You Can Do'),
    ],
    'status_notice' => $status_notice,
    'buttons' => $buttons,
    'more_options' => $more_options,
    'help' => [
      '#markup' => '<p>' . $instructions . '</p>',
    ],
    'series_buttons' => $series_buttons,
  ];
}

/**
 * Sends a Slack notification when a task is completed.
 */
function _makehaven_tasks_notify_slack($flagging) {
  $node = $flagging->getFlaggable();
  $user = $flagging->getOwner();

  // Load Slack webhook URL from Slack Connector configuration.
  $connector_config = \Drupal::config('slack_connector.settings');
  $webhook_url = $connector_config->get('webhook_url');
  if (empty($webhook_url)) {
    \Drupal::logger('makehaven_tasks')->error('Slack webhook URL is not configured in Slack Connector.');
    return;
  }

  // Default channel.
  $default_channel = '#tasks';

  // Get task title.
  $title = $node->label();

  // Generate an absolute URL for the node.
  $node_url = Url::fromRoute('entity.node.canonical', ['node' => $node->id()], ['absolute' => TRUE])->toString();

  // User name
  $completed_by = $user->getDisplayName();
  
  // Try to get Slack ID for mention
  $mention = " (by {$completed_by})";
  if ($user->hasField('field_member_slack_id_number') && !$user->get('field_member_slack_id_number')->isEmpty()) {
    $slack_username = $user->get('field_member_slack_id_number')->value;
    $mention = " (by <@{$slack_username}>)"; // Note: Slack API might need <@ID> format but simple text works often
  }

  // Build an array of channels to post to (same logic as poster)
  $channels = [$default_channel];

  // Check if the Task has a referenced "item" via field_task_equipment.
  if ($node->hasField('field_task_equipment') && !$node->get('field_task_equipment')->isEmpty()) {
    $item_node = $node->get('field_task_equipment')->entity;
    if ($item_node) {
      if ($item_node->hasField('field_item_slack_channel') && !$item_node->get('field_item_slack_channel')->isEmpty()) {
        $channel_name = $item_node->get('field_item_slack_channel')->value;
        $channels[] = '#' . ltrim($channel_name, '#');
      }
      if ($item_node->hasField('field_item_area_interest') && !$item_node->get('field_item_area_interest')->isEmpty()) {
        $terms = $item_node->get('field_item_area_interest')->referencedEntities();
        foreach ($terms as $term) {
          if ($term->hasField('field_interest_slack_channel') && !$term->get('field_interest_slack_channel')->isEmpty()) {
            $channel_name = $term->get('field_interest_slack_channel')->value;
            $channels[] = '#' . ltrim($channel_name, '#');
          }
        }
      }
    }
  }

  $channels = array_unique($channels);

  $message_text = "✅ Task Completed: '{$title}' {$mention} 
View Task: {$node_url}";

  $client = \Drupal::httpClient();
  foreach ($channels as $channel) {
    $data = [
      'channel' => $channel,
      'blocks' => [
        [
          'type' => 'section',
          'text' => [
            'type' => 'mrkdwn',
            'text' => $message_text,
          ],
        ],
      ],
    ];

    try {
      $client->post($webhook_url, [
        'headers' => ['Content-Type' => 'application/json'],
        'json' => $data,
      ]);
      \Drupal::logger('makehaven_tasks')->notice('Slack notification sent to @channel for task completion.', ['@channel' => $channel]);
    }
    catch (\Exception $e) {
      \Drupal::logger('makehaven_tasks')->error('Error posting to Slack: @error', ['@error' => $e->getMessage()]);
    }
  }
}

/**
 * Sends a Slack notification when a task is marked incomplete.
 */
function _makehaven_tasks_notify_slack_incomplete(NodeInterface $node, string $note): void {
  $connector_config = \Drupal::config('slack_connector.settings');
  $webhook_url = $connector_config->get('webhook_url');
  if (empty($webhook_url)) {
    \Drupal::logger('makehaven_tasks')->error('Slack webhook URL is not configured in Slack Connector.');
    return;
  }

  $default_channel = '#tasks';
  $title = $node->label();
  $node_url = Url::fromRoute('entity.node.canonical', ['node' => $node->id()], ['absolute' => TRUE])->toString();

  $channels = [$default_channel];

  if ($node->hasField('field_task_equipment') && !$node->get('field_task_equipment')->isEmpty()) {
    $item_node = $node->get('field_task_equipment')->entity;
    if ($item_node) {
      if ($item_node->hasField('field_item_slack_channel') && !$item_node->get('field_item_slack_channel')->isEmpty()) {
        $channel_name = $item_node->get('field_item_slack_channel')->value;
        $channels[] = '#' . ltrim($channel_name, '#');
      }
      if ($item_node->hasField('field_item_area_interest') && !$item_node->get('field_item_area_interest')->isEmpty()) {
        $terms = $item_node->get('field_item_area_interest')->referencedEntities();
        foreach ($terms as $term) {
          if ($term->hasField('field_interest_slack_channel') && !$term->get('field_interest_slack_channel')->isEmpty()) {
            $channel_name = $term->get('field_interest_slack_channel')->value;
            $channels[] = '#' . ltrim($channel_name, '#');
          }
        }
      }
    }
  }

  $channels = array_unique($channels);

  $message_text = "⚠ Task Incomplete: '{$title}' — needs someone to pick it up.
Note: {$note}
View Task: {$node_url}";

  $client = \Drupal::httpClient();
  foreach ($channels as $channel) {
    $data = [
      'channel' => $channel,
      'blocks' => [
        [
          'type' => 'section',
          'text' => [
            'type' => 'mrkdwn',
            'text' => $message_text,
          ],
        ],
      ],
    ];

    try {
      $client->post($webhook_url, [
        'headers' => ['Content-Type' => 'application/json'],
        'json' => $data,
      ]);
      \Drupal::logger('makehaven_tasks')->notice('Slack incomplete notification sent to @channel for task @nid.', ['@channel' => $channel, '@nid' => $node->id()]);
    }
    catch (\Exception $e) {
      \Drupal::logger('makehaven_tasks')->error('Error posting incomplete notification to Slack: @error', ['@error' => $e->getMessage()]);
    }
  }
}

/**
 * Implements hook_cron().
 */
function makehaven_tasks_cron() {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $query = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'task')
    ->condition('status', 0)
    ->exists('field_task_next_due')
    ->condition('field_task_next_due.value', gmdate('Y-m-d\TH:i:s'), '<=');

  $nids = $query->execute();
  if (!$nids) {
    return;
  }

  $tasks = $storage->loadMultiple($nids);
  foreach ($tasks as $task) {
    $task->setPublished(TRUE);
    $task->save();

    if (function_exists('slack_task_poster_send_message')) {
      slack_task_poster_send_message($task);
    }
  }
}

/**
 * Implements hook_node_access().
 */
function makehaven_tasks_node_access(NodeInterface $node, $op, AccountInterface $account) {
  if ($op !== 'view' || $node->bundle() !== 'task') {
    return AccessResult::neutral();
  }

  if (_makehaven_tasks_is_task_staff($account)) {
    return AccessResult::neutral();
  }

  $audience = _makehaven_tasks_get_task_audience($node);
  if ($audience === 'staff_only') {
    return AccessResult::forbidden()
      ->addCacheableDependency($node)
      ->cachePerPermissions();
  }

  if ($audience === 'badge_holders' && !_makehaven_tasks_user_meets_task_badge_requirement($node, $account)) {
    return AccessResult::forbidden()
      ->addCacheableDependency($node)
      ->cachePerUser();
  }

  return AccessResult::neutral();
}

/**
 * Returns TRUE when the account should be treated as task staff.
 */
function _makehaven_tasks_is_task_staff(AccountInterface $account): bool {
  return $account->hasPermission('edit any task content') || $account->hasPermission('administer nodes');
}

/**
 * Returns the normalized audience for a task.
 */
function _makehaven_tasks_get_task_audience(NodeInterface $task): string {
  if ($task->hasField('field_task_audience') && !$task->get('field_task_audience')->isEmpty()) {
    return (string) $task->get('field_task_audience')->value;
  }

  if ($task->hasField('field_task_required_badge') && !$task->get('field_task_required_badge')->isEmpty()) {
    return 'badge_holders';
  }

  return 'open_member';
}

/**
 * Returns TRUE when the account meets the task's badge requirement.
 */
function _makehaven_tasks_user_meets_task_badge_requirement(NodeInterface $task, AccountInterface $account): bool {
  if ($account->isAnonymous()) {
    return FALSE;
  }

  if (_makehaven_tasks_is_task_staff($account)) {
    return TRUE;
  }

  if (!$task->hasField('field_task_required_badge') || $task->get('field_task_required_badge')->isEmpty()) {
    return TRUE;
  }

  if (!\Drupal::hasService('appointment_facilitator.badge_gate')) {
    return FALSE;
  }

  $badge = $task->get('field_task_required_badge')->entity;
  if (!$badge) {
    return FALSE;
  }

  $gate = \Drupal::service('appointment_facilitator.badge_gate');
  return $gate->memberHasActiveOrBlankBadge((int) $account->id(), (int) $badge->id());
}

/**
 * Returns a field label when possible.
 */
function _makehaven_tasks_field_label_or_fallback(NodeInterface $task, string $field_name): string {
  if (!$task->hasField($field_name) || $task->get($field_name)->isEmpty()) {
    return 'None';
  }

  $value = $task->get($field_name)->value ?? NULL;
  $definition = $task->get($field_name)->getFieldDefinition();
  $allowed_values = $definition->getSetting('allowed_values');
  if (is_array($allowed_values) && $value !== NULL && isset($allowed_values[$value])) {
    return (string) $allowed_values[$value];
  }

  $item = $task->get($field_name)->first();
  if ($item && method_exists($item, 'getString')) {
    $string = trim($item->getString());
    if ($string !== '') {
      return $string;
    }
  }

  return 'Set';
}

/**
 * Creates the next recurring task occurrence after completion.
 */
function _makehaven_tasks_schedule_next_occurrence($flagging): void {
  $node = $flagging->getFlaggable();
  if (!$node instanceof NodeInterface || $node->bundle() !== 'task') {
    return;
  }

  $series_source = _makehaven_tasks_get_series_source($node);
  if ($series_source->hasField('field_task_series_paused') && (bool) $series_source->get('field_task_series_paused')->value) {
    return;
  }

  if (!$series_source->hasField('field_task_frequency') || $series_source->get('field_task_frequency')->isEmpty()) {
    return;
  }

  $frequency = (string) $series_source->get('field_task_frequency')->value;
  $next_due = _makehaven_tasks_calculate_next_due($frequency);
  if ($next_due === NULL) {
    return;
  }

  $duplicate = $series_source->createDuplicate();
  $duplicate->setNewRevision(FALSE);
  $duplicate->setCreatedTime(\Drupal::time()->getCurrentTime());

  // Reset per-occurrence status fields so new occurrences start clean.
  if ($duplicate->hasField('field_task_status')) {
    $duplicate->set('field_task_status', 'open');
  }
  if ($duplicate->hasField('field_task_claimed_by')) {
    $duplicate->set('field_task_claimed_by', NULL);
  }
  if ($duplicate->hasField('field_task_handoff_note')) {
    $duplicate->set('field_task_handoff_note', NULL);
  }

  if ($duplicate->hasField('field_task_next_due')) {
    $duplicate->set('field_task_next_due', $next_due);
  }

  if ($duplicate->hasField('field_task_series_source')) {
    $duplicate->set('field_task_series_source', (int) $series_source->id());
  }

  if ($duplicate->hasField('field_task_series_paused')) {
    $duplicate->set('field_task_series_paused', 0);
  }

  if ($duplicate->hasField('path')) {
    $duplicate->set('path', ['pathauto' => 1]);
  }

  $publish_now = $frequency === 'always';
  $duplicate->setPublished($publish_now);
  $duplicate->save();

  if ($publish_now && function_exists('slack_task_poster_send_message')) {
    slack_task_poster_send_message($duplicate);
  }
}

/**
 * Calculates the next due date for a recurring task.
 */
function _makehaven_tasks_calculate_next_due(string $frequency): ?string {
  $now = new \DateTimeImmutable('now', new \DateTimeZone('UTC'));

  $next = match ($frequency) {
    'always' => $now,
    'weekly' => $now->modify('+1 week'),
    'monthly' => $now->modify('+1 month'),
    'quarterly' => $now->modify('+3 months'),
    'yearly' => $now->modify('+1 year'),
    'biennial' => $now->modify('+2 years'),
    default => NULL,
  };

  return $next?->format('Y-m-d\TH:i:s');
}

/**
 * Returns TRUE when a frequency should behave as a recurring series.
 */
function _makehaven_tasks_is_recurring_frequency(string $frequency): bool {
  return in_array($frequency, ['always', 'weekly', 'monthly', 'quarterly', 'yearly', 'biennial'], TRUE);
}

/**
 * Returns the recurring series source task for an occurrence.
 */
function _makehaven_tasks_get_series_source(NodeInterface $task): NodeInterface {
  if ($task->hasField('field_task_series_source') && !$task->get('field_task_series_source')->isEmpty()) {
    $source = $task->get('field_task_series_source')->entity;
    if ($source instanceof NodeInterface) {
      return $source;
    }
  }

  return $task;
}
