<?php

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Url;
use Drupal\node\Entity\Node;
use Drupal\node\NodeInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_entity_insert().
 */
function makehaven_tasks_entity_insert(EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'flagging' || $entity->getFlagId() !== 'task_completed') {
    return;
  }

  _makehaven_tasks_notify_slack($entity);
  _makehaven_tasks_check_milestone($entity);
  _makehaven_tasks_write_maintenance_log($entity);
}

/**
 * Implements hook_user_view().
 *
 * Adds a "tasks completed" stats block to member profile pages (full view mode).
 */
function makehaven_tasks_user_view(array &$build, \Drupal\user\UserInterface $account, $display, $view_mode): void {
  if ($view_mode !== 'full') {
    return;
  }

  $count = _makehaven_tasks_user_completion_count((int) $account->id());
  if ($count === 0 && !\Drupal::currentUser()->hasPermission('administer users')) {
    return;
  }

  $milestone = \Drupal\makehaven_tasks\Controller\TaskLeaderboardController::milestoneLabel($count);
  $lb_url = \Drupal\Core\Url::fromRoute('makehaven_tasks.leaderboard')->toString();
  $history_url = \Drupal\Core\Url::fromRoute('makehaven_tasks.my_history')->toString();

  $milestone_html = $milestone
    ? '<span class="task-profile-milestone">' . htmlspecialchars($milestone, ENT_QUOTES, 'UTF-8') . '</span>'
    : '';

  $is_own = \Drupal::currentUser()->id() == $account->id();
  $history_link = $is_own
    ? ' · <a href="' . $history_url . '">View my history</a>'
    : '';

  $html = '<div class="task-profile-stats">'
    . '<span class="task-profile-count">'
    . '<strong>' . $count . '</strong> task' . ($count !== 1 ? 's' : '') . ' completed'
    . '</span>'
    . $milestone_html
    . '<span class="task-profile-links">'
    . '<a href="' . $lb_url . '">Community leaderboard</a>'
    . $history_link
    . '</span>'
    . '</div>';

  $build['task_stats'] = [
    '#markup' => \Drupal\Core\Render\Markup::create($html),
    '#weight' => 10,
    '#attached' => ['library' => ['makehaven_tasks/task_actions']],
  ];
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_task_form.
 *
 * Simplifies the task create/edit form by:
 *  - Surfacing only the essential fields at the top level
 *  - Collapsing secondary details into a "More details" group
 *  - Collapsing recurring-series config into its own group
 *  - Hiding fields that are never set at creation time (claimed_by, bank, etc.)
 *  - Removing standard Drupal noise (promote, sticky, path, sitemaps, redirects)
 */
function makehaven_tasks_form_node_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof \Drupal\Core\Entity\EntityFormInterface) {
    return;
  }
  $node = $form_object->getEntity();
  if (!$node instanceof NodeInterface || $node->bundle() !== 'task') {
    return;
  }
  // ── 1. Core fields — the essentials at the top ──────────────────────────
  // title is already weight -5. Body (description) comes right after.
  if (isset($form['body'])) {
    $form['body']['#weight'] = 1;
  }
  if (isset($form['field_task_equipment'])) {
    $form['field_task_equipment']['#weight'] = 2;
  }
  if (isset($form['field_task_priority'])) {
    $form['field_task_priority']['#weight'] = 3;
  }
  if (isset($form['field_task_audience'])) {
    $form['field_task_audience']['#weight'] = 4;
    $form['field_task_audience']['widget']['#description'] = t(
      'Who should see and claim this task? Choose "Staff only" for tasks requiring elevated access.'
    );
  }
  if (isset($form['field_task_category'])) {
    $form['field_task_category']['#weight'] = 5;
  }

  // ── 2. "More details" — collapsed in main content (NOT in sidebar) ────
  $form['task_details'] = [
    '#type'   => 'details',
    '#title'  => t('More details'),
    '#open'   => FALSE,
    '#weight' => 20,
  ];
  foreach ([
    'field_task_estimated_hours',
    'field_task_instructions',
    'field_task_image',
    'field_task_video_url',
    'field_task_video_instruction',
    'field_task_lead',
    'field_task_group',
    'field_task_bank',
  ] as $field) {
    if (isset($form[$field])) {
      $form[$field]['#group'] = 'task_details';
    }
  }

  // ── 3. "Recurring series" — collapsed in main content ─────────────────
  $form['task_recurring'] = [
    '#type'   => 'details',
    '#title'  => t('Recurring series'),
    '#open'   => FALSE,
    '#weight' => 21,
  ];
  foreach ([
    'field_task_frequency',
    'field_task_next_due',
    'field_task_series_paused',
    'field_task_series_source',
  ] as $field) {
    if (isset($form[$field])) {
      $form[$field]['#group'] = 'task_recurring';
    }
  }

  // Next due: render as date-only via #after_build that strips the time input.
  if (isset($form['field_task_next_due']['widget'][0]['value'])) {
    $form['field_task_next_due']['widget'][0]['value']['#date_time_element'] = 'none';
    $form['field_task_next_due']['widget'][0]['value']['#date_time_format'] = '';
    $form['field_task_next_due']['widget'][0]['value']['#after_build'][] = '_makehaven_tasks_datetime_date_only';
    $form['field_task_next_due']['widget'][0]['value']['#description'] = t('Date only — tasks do not track a time of day.');
  }

  // ── 4. Hide fields that shouldn't be set at create/edit time ──────────
  foreach (['field_task_status', 'field_task_claimed_by', 'comment_node_task'] as $field) {
    if (isset($form[$field])) {
      $form[$field]['#access'] = FALSE;
    }
  }

  // ── 5. Collapse the Gin sidebar "Advanced" section by default ─────────
  if (isset($form['advanced'])) {
    $form['advanced']['#open'] = FALSE;
  }

  // ── 6. Permission-based field visibility ───────────────────────────────
  // Only staff (manage_bank) sees recurring series config and bank checkbox.
  // Facilitators see the simple create form. Members can't reach this form
  // at all (they use bank or retroactive log).
  $account = \Drupal::currentUser();
  if (!$account->hasPermission('makehaven_tasks.manage_bank')) {
    $form['task_recurring']['#access'] = FALSE;
    if (isset($form['field_task_bank'])) {
      $form['field_task_bank']['#access'] = FALSE;
    }
  }

  // ── 7. Pre-populate equipment from query param (?field_task_equipment=NID)
  // This supports "New task for this tool" links from equipment pages.
  if ($node->isNew() && isset($form['field_task_equipment'])) {
    $equip_nid = \Drupal::request()->query->get('field_task_equipment');
    if ($equip_nid && is_numeric($equip_nid)) {
      $item = \Drupal\node\Entity\Node::load((int) $equip_nid);
      if ($item && $item->bundle() === 'item') {
        $form['field_task_equipment']['widget'][0]['target_id']['#default_value'] = $item;
      }
    }
  }

  // ── 5. Remove standard Drupal node-form noise ─────────────────────────────
  // Some of these elements (url_redirects, simple_sitemap) are injected by
  // other modules AFTER this form_alter runs, so isset() is unreliable. We use
  // an #after_build to hide them once the whole form tree is assembled.
  $form['#after_build'][] = '_makehaven_tasks_hide_form_noise';
  if (isset($form['revision_information'])) {
    $form['revision_information']['#access'] = FALSE;
  }
}

/**
 * #after_build: hide common node-form sidebar noise that isn't relevant for
 * the task workflow. Runs after all other modules have added their children.
 */
function _makehaven_tasks_hide_form_noise(array $form, \Drupal\Core\Form\FormStateInterface $form_state): array {
  $noise_keys = [
    'promote', 'sticky', 'path', 'simple_sitemap', 'simple_sitemap_default',
    'url_redirects', 'redirect', 'menu',
  ];
  foreach ($noise_keys as $key) {
    if (isset($form[$key])) {
      $form[$key]['#access'] = FALSE;
    }
  }
  return $form;
}

/**
 * #after_build callback that strips the time sub-element from a datetime form
 * element, leaving only the date picker. The submitted value ends up with a
 * default time of 12:00:00, which is acceptable — tasks are day-granular.
 */
function _makehaven_tasks_datetime_date_only(array $element, \Drupal\Core\Form\FormStateInterface $form_state): array {
  if (isset($element['time'])) {
    $element['time']['#access'] = FALSE;
    $element['time']['#value'] = '12:00:00';
  }
  return $element;
}

/**
 * Implements hook_node_insert().
 *
 * Notify the task lead when a new published task node is created.
 */
function makehaven_tasks_node_insert(NodeInterface $node) {
  if ($node->bundle() === 'task' && $node->isPublished()) {
    _makehaven_tasks_notify_lead_due($node);
  }
}

/**
 * Implements hook_views_query_alter().
 *
 * Hides staff_only tasks from users who are not staff/admin.
 * Badge-required tasks remain visible to all — the badge field gate handles
 * the actual access; facilitators can see what needs their skills.
 */
function makehaven_tasks_views_query_alter(ViewExecutable $view, $query) {
  if ($view->id() !== 'tasks') {
    return;
  }
  if (!$query instanceof \Drupal\views\Plugin\views\query\Sql) {
    return;
  }

  $account = \Drupal::currentUser();
  $staff_roles = ['administrator', 'manager', 'content_editor'];
  $is_staff = (bool) array_intersect($staff_roles, $account->getRoles());
  if (!$is_staff) {
    // Ensure the audience table is joined — the view doesn't reference it
    // directly, so we must add the relationship before filtering on it.
    $join = \Drupal\views\Views::pluginManager('join')->createInstance('standard', [
      'table' => 'node__field_task_audience',
      'field' => 'entity_id',
      'left_table' => 'node_field_data',
      'left_field' => 'nid',
      'type' => 'LEFT',
      'extra' => [
        ['field' => 'deleted', 'value' => 0, 'numeric' => TRUE],
      ],
    ]);
    $audience_alias = $query->ensureTable('node__field_task_audience', NULL, $join);
    $query->addWhereExpression(0,
      "($audience_alias.field_task_audience_value IS NULL OR $audience_alias.field_task_audience_value <> 'staff_only')"
    );
  }

  // Note: "no priority goes last" is applied via hook_query_TAG_alter on the
  // views_tasks query tag below, because Views' SQL orderby can't take raw
  // SQL expressions without escaping them as column names.
}

/**
 * Implements hook_query_TAG_alter() for the "views_tasks" tag.
 *
 * Prepends an expression order so tasks with no priority sort to the bottom.
 * Runs on the raw Select query (after Views has built it), where we can add
 * expression orderBy clauses that the database layer will pass through.
 */
function makehaven_tasks_query_views_tasks_alter(\Drupal\Core\Database\Query\AlterableInterface $query): void {
  if (!$query instanceof \Drupal\Core\Database\Query\SelectInterface) {
    return;
  }
  // Find the priority table alias used in this query.
  $tables = $query->getTables();
  $priority_alias = NULL;
  foreach ($tables as $alias => $info) {
    if (($info['table'] ?? NULL) === 'node__field_task_priority') {
      $priority_alias = $alias;
      break;
    }
  }
  if (!$priority_alias) {
    return;
  }

  // Prepend an "IS NULL" order so NULL priorities end up last while the
  // existing ASC sort on the value still applies to non-NULL rows.
  $expr = "({$priority_alias}.field_task_priority_value IS NULL OR {$priority_alias}.field_task_priority_value = '')";
  $existing = &$query->getOrderBy();
  $new_order = ['mh_priority_null_last' => 'ASC'] + $existing;
  $existing = $new_order;
  $query->addExpression($expr, 'mh_priority_null_last');
}

/**
 * Implements hook_node_presave().
 *
 * Defaults field_task_status to 'open' when a task is first published.
 */
function makehaven_tasks_node_presave(NodeInterface $node) {
  if ($node->bundle() !== 'task') {
    return;
  }
  if ($node->isPublished() && $node->get('field_task_status')->isEmpty()) {
    $node->set('field_task_status', 'open');
  }
}

/**
 * Implements hook_node_view().
 *
 * Injects the status action UI (claim / handoff) on full task node pages.
 */
function makehaven_tasks_node_view(array &$build, NodeInterface $node, $display, $view_mode) {
  if ($view_mode !== 'full') {
    return;
  }

  // Equipment / item pages: inject a "Create task" link for staff so they can
  // quickly spin up a task from the bank for this specific tool.
  if ($node->bundle() === 'item') {
    _makehaven_tasks_inject_item_links($build, $node);
    return;
  }

  if ($node->bundle() !== 'task') {
    return;
  }

  $build['#attached']['library'][] = 'makehaven_tasks/task_actions';
  $nid = $node->id();

  // ── 1. Always-run cleanup: back link, hide empty fields, hide recurring ──

  $tasks_url = \Drupal\Core\Url::fromUserInput('/tasks')->toString();

  // Staff edit link — Gin hides the local task tabs; give staff an explicit
  // edit button so they don't need to hunt for the pencil icon.
  $edit_html = '';
  if ($node->access('update')) {
    $edit_url = \Drupal\Core\Url::fromRoute('entity.node.edit_form', ['node' => $nid])->toString();
    $edit_html = '<a href="' . $edit_url . '" class="tap-btn tap-btn--edit">✏ Edit task</a>';
  }

  $build['task_toolbar'] = [
    '#markup' => '<div class="task-toolbar">'
      . '<a href="' . $tasks_url . '" class="task-back-link-inline">← Back to all tasks</a>'
      . $edit_html
      . '</div>',
    '#weight' => -20,
  ];

  // Suppress raw field label/value pairs the action panel shows better.
  // Use unset() instead of #access=FALSE — Gin theme can ignore #access.
  foreach (['field_task_status', 'field_task_claimed_by'] as $field) {
    unset($build[$field]);
  }

  // Remove empty fields — Gin renders labels even when values are blank.
  $hide_when_empty = [
    'field_task_lead', 'field_task_equipment', 'field_task_group',
    'field_task_bank', 'field_task_image', 'field_task_estimated_hours',
    'field_task_instructions', 'field_task_video_url',
    'field_task_video_instruction', 'field_task_category',
    'field_task_audience', 'field_task_priority',
  ];
  foreach ($hide_when_empty as $field) {
    if ($node->hasField($field) && $node->get($field)->isEmpty()) {
      unset($build[$field]);
    }
  }

  // Hide recurring-series fields on non-recurring tasks. "once" is not
  // a recurring frequency, so exclude it.
  $freq = $node->hasField('field_task_frequency') ? $node->get('field_task_frequency')->value : NULL;
  $is_recurring = $freq && $freq !== 'once';
  $recurring_fields = [
    'field_task_frequency', 'field_task_next_due',
    'field_task_series_source', 'field_task_series_paused',
  ];
  foreach ($recurring_fields as $field) {
    if (!$is_recurring) {
      unset($build[$field]);
    }
  }

  // Also hide task_bank — it's a dead feature with no UI.
  unset($build['field_task_bank']);

  // Move the Flag "Mark as Done" button to sit inside the action panel area.
  if (isset($build['flag_task_completed'])) {
    $build['flag_task_completed']['#weight'] = 5;
  }

  // Suppress duplicate flag link from node links area.
  if (isset($build['links']) && is_array($build['links'])) {
    foreach (array_keys($build['links']) as $lkey) {
      if (is_string($lkey) && strpos($lkey, 'flag') !== FALSE) {
        $build['links'][$lkey]['#access'] = FALSE;
      }
    }
  }

  // ── 2. Completion state — if already done, show "Completed by" panel ──

  $flag_service = \Drupal::service('flag');
  $flag = $flag_service->getFlagById('task_completed');
  $completion_flagging = $flag ? $flag_service->getFlagging($flag, $node) : NULL;

  if ($completion_flagging) {
    $completer_uid = (int) $completion_flagging->get('uid')->target_id;
    $when = \Drupal::service('date.formatter')->format($completion_flagging->get('created')->value, 'medium');
    $face = _makehaven_tasks_render_face($completer_uid, (string) t('Completed'), 'md');
    $build['task_completed_panel'] = [
      '#markup' => '<div class="task-action-panel task-action-panel--done">'
        . '<div class="tap-done-row">' . $face
        . '<span class="tap-done-stamp">✓ ' . htmlspecialchars((string) $when, ENT_QUOTES) . '</span>'
        . '</div></div>',
      '#weight' => -10,
    ];
    return;
  }

  // ── 3. Active task — claim / handoff / mark-done action panel ──

  if (!\Drupal::currentUser()->isAuthenticated()) {
    return;
  }

  $status = $node->get('field_task_status')->value ?? 'open';
  $current_uid = \Drupal::currentUser()->id();
  $token = \Drupal::csrfToken()->get("task-action/{$nid}");

  $claim_url = \Drupal\Core\Url::fromRoute('makehaven_tasks.claim', ['node' => $nid], [
    'query' => ['token' => $token],
  ])->toString();
  $handoff_url = \Drupal\Core\Url::fromRoute('makehaven_tasks.handoff', ['node' => $nid])->toString();

  $claimed_by = $node->get('field_task_claimed_by')->target_id;
  $is_claimed_by_me = $claimed_by && $claimed_by == $current_uid;

  // Check whether the current user is allowed to claim based on audience.
  $audience = $node->hasField('field_task_audience') ? $node->get('field_task_audience')->value : NULL;
  $account = \Drupal::currentUser();
  $user_roles = $account->getRoles();
  $staff_roles = ['administrator', 'manager', 'content_editor'];
  $is_staff = (bool) array_intersect($staff_roles, $user_roles);
  $can_claim = TRUE;
  if ($audience === 'staff_only' && !$is_staff) {
    $can_claim = FALSE;
  }
  if ($audience === 'badge_holders' && !$is_staff && !in_array('facilitator', $user_roles)) {
    $can_claim = FALSE;
  }

  // Status context row.
  $status_html = '';
  if ($audience === 'badge_holders') {
    $status_html .= '<span class="tap-badge tap-badge--badge">🔑 Requires a badge</span>';
  }
  elseif ($audience === 'staff_only') {
    $status_html .= '<span class="tap-badge tap-badge--staff">🔒 Staff only</span>';
  }
  if ($status === 'incomplete') {
    $status_html .= '<span class="tap-badge tap-badge--incomplete">⚠ Needs attention</span>';
  }
  elseif ($status === 'in_progress') {
    $status_html .= '<span class="tap-badge tap-badge--inprogress">🔧 In progress</span>';
    if ($claimed_by) {
      $status_html .= _makehaven_tasks_render_face((int) $claimed_by, (string) t('Claimed by'), 'md');
    }
  }

  // Primary actions — only show claim button if user is allowed.
  $primary_html = '';
  if (!$can_claim) {
    $label = $audience === 'staff_only' ? 'Staff only' : 'Requires a badge';
    $primary_html .= '<span class="tap-btn tap-btn--claimed">' . $label . '</span>';
  }
  elseif ($status === 'incomplete') {
    $primary_html .= '<a href="' . $claim_url . '" class="tap-btn tap-btn--claim">✋ Pick this up</a>';
  }
  elseif (!$is_claimed_by_me) {
    $primary_html .= '<a href="' . $claim_url . '" class="tap-btn tap-btn--claim">✋ Claim task</a>';
  }
  else {
    $primary_html .= '<span class="tap-btn tap-btn--claimed">✓ You\'ve claimed this</span>';
  }

  // Secondary actions.
  $secondary_html = '';
  if ($status === 'incomplete') {
    $secondary_html .= '<a href="' . $handoff_url . '" class="tap-link">Update handoff note</a>';
  }
  else {
    $secondary_html .= '<a href="' . $handoff_url . '" class="tap-link tap-link--danger">I couldn\'t finish — hand off</a>';
  }
  if ($node->hasField('field_task_equipment') && !$node->get('field_task_equipment')->isEmpty()) {
    $item_nid = $node->get('field_task_equipment')->target_id;
    $log_url = \Drupal\Core\Url::fromRoute('makehaven_tasks.retroactive_log', [], [
      'query' => ['equipment' => $item_nid],
    ])->toString();
    $secondary_html .= '<a href="' . $log_url . '" class="tap-link">Log a different fix for this tool</a>';
  }

  // Assemble the action panel.
  $actions_html = '<div class="task-action-panel">';
  if ($status_html) {
    $actions_html .= '<div class="tap-status-row">' . $status_html . '</div>';
  }
  $actions_html .= '<div class="tap-primary-row">' . $primary_html . '</div>';
  $actions_html .= '<div class="tap-secondary-row">' . $secondary_html . '</div>';
  $actions_html .= '</div>';

  $build['task_status_actions'] = [
    '#markup' => $actions_html,
    '#weight' => -10,
  ];
}

/**
 * Implements hook_node_links_alter().
 *
 * Removes the duplicate flag link from the node links area on task full pages.
 * The flag button in the node display already handles mark-as-done.
 */
function makehaven_tasks_node_links_alter(array &$links, NodeInterface $node, array &$context) {
  if ($node->bundle() !== 'task' || $context['view_mode'] !== 'full') {
    return;
  }
  // Flag module may register the link under different keys depending on
  // module version; drop anything starting with "flag".
  foreach (array_keys($links) as $key) {
    if (strpos($key, 'flag') === 0) {
      unset($links[$key]);
    }
  }
}

/**
 * Implements hook_cron().
 *
 * Generates occurrences for series source tasks whose next due date has passed.
 */
function makehaven_tasks_cron() {
  $frequency_days = [
    'weekly' => 7,
    'monthly' => 30,
    'quarterly' => 90,
    'yearly' => 365,
    'biennial' => 730,
  ];

  $now = new \DateTime('now', new \DateTimeZone('UTC'));
  $now_str = $now->format('Y-m-d\TH:i:s');

  // Find published series source nodes (no field_task_series_source set) that
  // have a recurring frequency and an overdue field_task_next_due.
  $query = \Drupal::entityQuery('node')
    ->condition('type', 'task')
    ->condition('status', NodeInterface::PUBLISHED)
    ->condition('field_task_frequency', array_keys($frequency_days), 'IN')
    ->condition('field_task_next_due', $now_str, '<=')
    ->notExists('field_task_series_source')
    ->accessCheck(FALSE);

  // Only process non-paused series.
  $query->condition('field_task_series_paused', TRUE, '<>');

  $nids = $query->execute();

  if (empty($nids)) {
    return;
  }

  foreach ($nids as $source_nid) {
    $source = Node::load($source_nid);
    if (!$source) {
      continue;
    }

    $frequency = $source->field_task_frequency->value;
    $days = $frequency_days[$frequency] ?? NULL;
    if (!$days) {
      continue;
    }

    // Skip if there's already an active incomplete occurrence — it must be
    // resolved (flagged complete) before a new occurrence is created.
    $active_incomplete = \Drupal::entityQuery('node')
      ->condition('type', 'task')
      ->condition('status', NodeInterface::PUBLISHED)
      ->condition('field_task_series_source', $source_nid)
      ->condition('field_task_status', 'incomplete')
      ->accessCheck(FALSE)
      ->count()
      ->execute();
    if ($active_incomplete > 0) {
      \Drupal::logger('makehaven_tasks')->notice(
        'Skipping occurrence generation for series @nid — active incomplete occurrence exists.',
        ['@nid' => $source_nid]
      );
      continue;
    }

    // Clone the series source as a new published occurrence.
    $occurrence = _makehaven_tasks_create_occurrence($source);
    if (!$occurrence) {
      continue;
    }

    // Advance next_due on the series source by the frequency interval,
    // calculated from the existing next_due date (not from now) to stay on schedule.
    $due_date = new \DateTime($source->field_task_next_due->value, new \DateTimeZone('UTC'));
    $due_date->modify("+{$days} days");
    $source->set('field_task_next_due', $due_date->format('Y-m-d\TH:i:s'));
    $source->save();

    \Drupal::logger('makehaven_tasks')->notice(
      'Created task occurrence @nid from series source @source_nid. Next due: @next_due.',
      [
        '@nid' => $occurrence->id(),
        '@source_nid' => $source_nid,
        '@next_due' => $due_date->format('Y-m-d'),
      ]
    );
  }
}

/**
 * Returns open (unflagged, non-incomplete) task NIDs keyed by title for an item node.
 *
 * @param int $item_nid
 *   The item/tool node ID.
 *
 * @return array
 *   NID => title pairs for open tasks linked to this item.
 */
function _makehaven_tasks_open_tasks_for_item($item_nid) {
  $nids = \Drupal::entityQuery('node')
    ->condition('type', 'task')
    ->condition('status', 1)
    ->condition('field_task_equipment', $item_nid)
    ->condition('field_task_status', 'incomplete', '<>')
    ->accessCheck(FALSE)
    ->execute();

  if (empty($nids)) {
    return [];
  }

  // Filter out tasks already flagged complete by anyone.
  $flag_service = \Drupal::service('flag');
  $flag = $flag_service->getFlagById('task_completed');
  $result = [];
  foreach ($nids as $nid) {
    $node = \Drupal\node\Entity\Node::load($nid);
    if (!$node) {
      continue;
    }
    // getEntityFlaggings returns all flaggings regardless of user, so this
    // correctly identifies tasks completed by any member.
    if ($flag && !empty($flag_service->getEntityFlaggings($flag, $node))) {
      continue;
    }
    $result[$nid] = $node->label();
  }
  return $result;
}

/**
 * Sends a Slack notification when a task is handed off as incomplete.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The task node.
 * @param string $note
 *   The handoff note.
 * @param int $from_uid
 *   The user handing off.
 * @param int|null $reassign_uid
 *   The new lead UID if reassigned, or NULL.
 */
function _makehaven_tasks_notify_handoff($node, $note, $from_uid, $reassign_uid) {
  $connector_config = \Drupal::config('slack_connector.settings');
  $webhook_url = $connector_config->get('webhook_url');
  if (empty($webhook_url)) {
    return;
  }

  $from_user = \Drupal\user\Entity\User::load($from_uid);
  $from_name = $from_user ? $from_user->getDisplayName() : 'Someone';
  $from_slack = $from_user ? _makehaven_tasks_get_slack_id($from_user) : NULL;
  $from_mention = $from_slack ? "<@{$from_slack}>" : $from_name;

  $title = $node->label();
  $node_url = \Drupal\Core\Url::fromRoute('entity.node.canonical', ['node' => $node->id()], ['absolute' => TRUE])->toString();

  $reassign_mention = '';
  if ($reassign_uid) {
    $reassign_user = \Drupal\user\Entity\User::load($reassign_uid);
    if ($reassign_user) {
      $reassign_slack = _makehaven_tasks_get_slack_id($reassign_user);
      $reassign_mention = $reassign_slack
        ? " — handed to <@{$reassign_slack}>"
        : " — handed to {$reassign_user->getDisplayName()}";
    }
  }

  $message = "⚠ Task needs attention: *{$title}*\n{$from_mention} couldn't finish{$reassign_mention}\n_{$note}_\n{$node_url}";

  // Route to #tasks + the area channel.
  $channels = ['#tasks'];
  if ($node->hasField('field_task_equipment') && !$node->get('field_task_equipment')->isEmpty()) {
    $item_node = $node->get('field_task_equipment')->entity;
    if ($item_node) {
      if ($item_node->hasField('field_item_slack_channel') && !$item_node->get('field_item_slack_channel')->isEmpty()) {
        $channels[] = '#' . ltrim($item_node->get('field_item_slack_channel')->value, '#');
      }
      if ($item_node->hasField('field_item_area_interest') && !$item_node->get('field_item_area_interest')->isEmpty()) {
        foreach ($item_node->get('field_item_area_interest')->referencedEntities() as $term) {
          if ($term->hasField('field_interest_slack_channel') && !$term->get('field_interest_slack_channel')->isEmpty()) {
            $channels[] = '#' . ltrim($term->get('field_interest_slack_channel')->value, '#');
          }
        }
      }
    }
  }

  $channels = array_unique($channels);
  $client = \Drupal::httpClient();
  foreach ($channels as $channel) {
    try {
      $client->post($webhook_url, [
        'headers' => ['Content-Type' => 'application/json'],
        'json' => [
          'channel' => $channel,
          'blocks' => [[
            'type' => 'section',
            'text' => ['type' => 'mrkdwn', 'text' => $message],
          ]],
        ],
      ]);
    }
    catch (\Exception $e) {
      \Drupal::logger('makehaven_tasks')->error('Error posting handoff Slack notification: @error', ['@error' => $e->getMessage()]);
    }
  }
}

/**
 * Renders a member "face" (avatar circle + name) for a given uid.
 *
 * Mirrors the appointment_facilitator pattern: pulls field_member_photo off
 * the user's main profile, falls back to initials in a gray circle.
 *
 * @param int $uid
 *   The user ID.
 * @param string $label
 *   Role label shown beside the name (e.g. "Claimed", "Completed").
 * @param string $size
 *   'sm' (32px, for cards) or 'md' (56px, for full node view).
 *
 * @return string
 *   Rendered HTML, or empty string if uid is invalid.
 */
function _makehaven_tasks_render_face(int $uid, string $label, string $size = 'md'): string {
  if ($uid <= 0) {
    return '';
  }
  $user = \Drupal\user\Entity\User::load($uid);
  if (!$user) {
    return '';
  }
  $display_name = $user->getDisplayName();

  $img_html = '';
  $profile = NULL;
  if (\Drupal::entityTypeManager()->hasDefinition('profile')) {
    $profiles = \Drupal::entityTypeManager()->getStorage('profile')
      ->loadByProperties(['uid' => $uid, 'type' => 'main', 'status' => 1]);
    $profile = reset($profiles);
  }
  if ($profile && $profile->hasField('field_member_photo') && !$profile->get('field_member_photo')->isEmpty()) {
    $fid = (int) $profile->get('field_member_photo')->target_id;
    $file = \Drupal::entityTypeManager()->getStorage('file')->load($fid);
    if ($file) {
      $url = \Drupal::service('file_url_generator')->generateString($file->getFileUri());
      $img_html = '<img src="' . htmlspecialchars($url, ENT_QUOTES) . '" alt="'
        . htmlspecialchars($display_name, ENT_QUOTES) . '" class="task-face__img">';
    }
  }

  if (!$img_html) {
    $words = explode(' ', trim($display_name));
    $initials = '';
    foreach ($words as $w) {
      $initials .= mb_strtoupper(mb_substr($w, 0, 1));
    }
    $initials = htmlspecialchars(mb_substr($initials, 0, 2), ENT_QUOTES);
    $img_html = '<span class="task-face__initials">' . $initials . '</span>';
  }

  $profile_url = '/user/' . $uid;
  $name_html = htmlspecialchars($display_name, ENT_QUOTES);
  $label_html = htmlspecialchars($label, ENT_QUOTES);
  $size_class = 'task-face--' . ($size === 'sm' ? 'sm' : 'md');

  return '<a href="' . $profile_url . '" class="task-face ' . $size_class . '" title="' . $label_html . ': ' . $name_html . '">'
    . '<span class="task-face__circle">' . $img_html . '</span>'
    . '<span class="task-face__meta">'
    . '<span class="task-face__label">' . $label_html . '</span>'
    . '<span class="task-face__name">' . $name_html . '</span>'
    . '</span>'
    . '</a>';
}

/**
 * Injects task-related links on equipment/item node pages.
 *
 * Staff see:
 *  - "Create task from bank" (filtered to this equipment)
 *  - "Create new task" (pre-selects this equipment)
 *  - Open tasks for this equipment (if any)
 */
function _makehaven_tasks_inject_item_links(array &$build, NodeInterface $item_node): void {
  $account = \Drupal::currentUser();
  $can_bank = $account->hasPermission('makehaven_tasks.create_from_bank');
  $can_create = $account->hasPermission('makehaven_tasks.create_task');
  if (!$can_bank && !$can_create) {
    return;
  }

  $nid = $item_node->id();
  $links = [];

  // Bank link filtered to this equipment (members + facilitators + staff).
  if ($can_bank) {
    $bank_count = (int) \Drupal::entityQuery('node')
      ->condition('type', 'task')
      ->condition('field_task_bank', 'task_bank')
      ->condition('field_task_equipment', $nid)
      ->accessCheck(FALSE)
      ->count()
      ->execute();

    if ($bank_count > 0) {
      $bank_url = \Drupal\Core\Url::fromRoute('makehaven_tasks.bank', [], [
        'query' => ['equipment' => $nid],
      ])->toString();
      $bank_label = "📦 Task bank ({$bank_count} template" . ($bank_count > 1 ? 's' : '') . ')';
      $links[] = '<a href="' . $bank_url . '" class="task-staff-btn task-staff-btn--primary">' . $bank_label . '</a>';
    }
  }

  // Direct create with equipment pre-selected (facilitators + staff only).
  if ($can_create) {
    $create_url = \Drupal\Core\Url::fromRoute('node.add', ['node_type' => 'task'], [
      'query' => ['field_task_equipment' => $nid],
    ])->toString();
    $links[] = '<a href="' . $create_url . '" class="task-staff-btn">+ New task for this tool</a>';
  }

  // Show open tasks for this equipment.
  $open_tasks = _makehaven_tasks_open_tasks_for_item((int) $nid);
  $open_html = '';
  if (!empty($open_tasks)) {
    $items = [];
    foreach ($open_tasks as $task_nid => $title) {
      $url = \Drupal\Core\Url::fromRoute('entity.node.canonical', ['node' => $task_nid])->toString();
      $items[] = '<a href="' . $url . '">' . htmlspecialchars($title, ENT_QUOTES) . '</a>';
    }
    $open_html = '<div class="task-item-open">'
      . '<strong>' . count($open_tasks) . ' open task' . (count($open_tasks) !== 1 ? 's' : '') . ':</strong> '
      . implode(' · ', $items)
      . '</div>';
  }

  $build['task_item_actions'] = [
    '#markup' => '<div class="task-item-panel">'
      . '<div class="task-staff-bar">' . implode('', $links) . '</div>'
      . $open_html
      . '</div>',
    '#weight' => 90,
    '#attached' => ['library' => ['makehaven_tasks/task_actions']],
  ];
}

/**
 * Gets a user's Slack ID from their profile entity.
 *
 * field_member_slack_id_number lives on the profile entity, not the user.
 *
 * @param \Drupal\user\UserInterface $user
 *   The user account.
 *
 * @return string|null
 *   The Slack member ID (e.g. "U0123ABC") or NULL if not set.
 */
function _makehaven_tasks_get_slack_id($user) {
  if (!$user || $user->isAnonymous()) {
    return NULL;
  }
  $profiles = \Drupal::entityTypeManager()
    ->getStorage('profile')
    ->loadByProperties(['uid' => $user->id(), 'type' => 'main', 'status' => 1]);
  if (empty($profiles)) {
    return NULL;
  }
  $profile = reset($profiles);
  if ($profile->hasField('field_member_slack_id_number') && !$profile->get('field_member_slack_id_number')->isEmpty()) {
    return $profile->get('field_member_slack_id_number')->value;
  }
  return NULL;
}

/**
 * Creates a published occurrence node from a series source node.
 *
 * Copies all relevant fields and sets field_task_series_source to the source.
 * Notifies the lead after saving.
 *
 * @param \Drupal\node\NodeInterface $source
 *   The series source task node.
 *
 * @return \Drupal\node\NodeInterface|null
 *   The new occurrence node, or NULL on failure.
 */
function _makehaven_tasks_create_occurrence(NodeInterface $source) {
  $fields_to_copy = [
    'body',
    'field_task_audience',
    'field_task_bank',
    'field_task_category',
    'field_task_equipment',
    'field_task_frequency',
    'field_task_group',
    'field_task_image',
    'field_task_instructions',
    'field_task_lead',
    'field_task_priority',
    'field_task_required_badge',
    'field_task_estimated_hours',
    'field_task_video_instruction',
    'field_task_video_url',
  ];

  $values = [
    'type' => 'task',
    'title' => $source->label(),
    'status' => NodeInterface::PUBLISHED,
    'uid' => $source->getOwnerId(),
    'field_task_series_source' => ['target_id' => $source->id()],
  ];

  foreach ($fields_to_copy as $field_name) {
    if ($source->hasField($field_name) && !$source->get($field_name)->isEmpty()) {
      $values[$field_name] = $source->get($field_name)->getValue();
    }
  }

  try {
    $occurrence = Node::create($values);
    $occurrence->save();
    return $occurrence;
  }
  catch (\Exception $e) {
    \Drupal::logger('makehaven_tasks')->error(
      'Failed to create task occurrence from source @nid: @error',
      ['@nid' => $source->id(), '@error' => $e->getMessage()]
    );
    return NULL;
  }
}

/**
 * Sends a Slack notification to the task lead (and area channel) when a task is due.
 *
 * Uses @mention in the area channel since incoming webhooks cannot send DMs.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The newly published task node.
 */
function _makehaven_tasks_notify_lead_due(NodeInterface $node) {
  // Only notify if the task has a lead.
  if ($node->get('field_task_lead')->isEmpty()) {
    return;
  }

  $connector_config = \Drupal::config('slack_connector.settings');
  $webhook_url = $connector_config->get('webhook_url');
  if (empty($webhook_url)) {
    return;
  }

  $lead_user = $node->get('field_task_lead')->entity;
  if (!$lead_user) {
    return;
  }

  $title = $node->label();
  $node_url = Url::fromRoute('entity.node.canonical', ['node' => $node->id()], ['absolute' => TRUE])->toString();

  $slack_id = _makehaven_tasks_get_slack_id($lead_user);
  $lead_mention = $slack_id ? "<@{$slack_id}>" : $lead_user->getDisplayName();

  $audience_note = '';
  if ($node->hasField('field_task_audience')) {
    $audience_map = ['badge_holders' => ' _(requires badge)_', 'staff_only' => ' _(staff only)_'];
    $audience_note = $audience_map[$node->get('field_task_audience')->value] ?? '';
  }
  $message = "📋 Task due{$audience_note}: *{$title}*\nAssigned to: {$lead_mention}\n{$node_url}";

  // Collect channels: #tasks always, plus equipment area channel if set.
  $channels = ['#tasks'];
  if ($node->hasField('field_task_equipment') && !$node->get('field_task_equipment')->isEmpty()) {
    $item_node = $node->get('field_task_equipment')->entity;
    if ($item_node) {
      if ($item_node->hasField('field_item_slack_channel') && !$item_node->get('field_item_slack_channel')->isEmpty()) {
        $channels[] = '#' . ltrim($item_node->get('field_item_slack_channel')->value, '#');
      }
      if ($item_node->hasField('field_item_area_interest') && !$item_node->get('field_item_area_interest')->isEmpty()) {
        foreach ($item_node->get('field_item_area_interest')->referencedEntities() as $term) {
          if ($term->hasField('field_interest_slack_channel') && !$term->get('field_interest_slack_channel')->isEmpty()) {
            $channels[] = '#' . ltrim($term->get('field_interest_slack_channel')->value, '#');
          }
        }
      }
    }
  }

  $channels = array_unique($channels);
  $client = \Drupal::httpClient();

  foreach ($channels as $channel) {
    $data = [
      'channel' => $channel,
      'blocks' => [[
        'type' => 'section',
        'text' => ['type' => 'mrkdwn', 'text' => $message],
      ]],
    ];
    try {
      $client->post($webhook_url, [
        'headers' => ['Content-Type' => 'application/json'],
        'json' => $data,
      ]);
    }
    catch (\Exception $e) {
      \Drupal::logger('makehaven_tasks')->error('Error posting task-due Slack notification: @error', ['@error' => $e->getMessage()]);
    }
  }
}

/**
 * Implements hook_preprocess_views_view().
 *
 * Attaches the task CSS library and appends a staff-only link to the banner
 * for users with elevated roles. The static banner content lives in the view's
 * header area config (more reliable than preprocess injection).
 */
function makehaven_tasks_preprocess_views_view(&$variables) {
  $view = $variables['view'];
  if ($view->id() !== 'tasks' || $view->current_display !== 'page_tasks_interactive') {
    return;
  }

  // Always attach the CSS library (the header area plugin doesn't do this).
  $variables['#attached']['library'][] = 'makehaven_tasks/task_actions';

  $account = \Drupal::currentUser();
  if (!$account->isAuthenticated()) {
    return;
  }

  // Single unified toolbar: nav links left, action buttons right.
  $left = '';
  $right = '';

  // Left side — member navigation (daily-use links).
  $left .= '<a href="' . \Drupal\Core\Url::fromRoute('makehaven_tasks.my_history')->toString() . '" class="task-nav-link">📋 My tasks</a>';
  $left .= '<a href="' . \Drupal\Core\Url::fromRoute('makehaven_tasks.leaderboard')->toString() . '" class="task-nav-link">🏆 Leaderboard</a>';
  if ($account->hasPermission('makehaven_tasks.create_from_bank')) {
    $left .= '<a href="' . \Drupal\Core\Url::fromRoute('makehaven_tasks.bank')->toString() . '" class="task-nav-link">📦 Task bank</a>';
  }

  // Right side — action buttons (permission-gated).
  if ($account->hasPermission('makehaven_tasks.create_task')) {
    $right .= '<a href="' . \Drupal\Core\Url::fromRoute('node.add', ['node_type' => 'task'])->toString() . '" class="task-staff-btn task-staff-btn--primary">+ Create task</a>';
  }
  if ($account->hasPermission('makehaven_tasks.manage_tasks')) {
    $right .= '<a href="' . \Drupal\Core\Url::fromRoute('makehaven_tasks.manage')->toString() . '" class="task-staff-btn">⚙ Manager</a>';
  }

  $variables['header']['task_toolbar'] = [
    '#markup' => \Drupal\Core\Render\Markup::create(
      '<nav class="task-toolbar-bar" aria-label="Task navigation">'
      . '<div class="task-toolbar-left">' . $left . '</div>'
      . ($right ? '<div class="task-toolbar-right">' . $right . '</div>' : '')
      . '</nav>'
    ),
    '#weight' => -60,
  ];
}

/**
 * Implements hook_preprocess_views_view_unformatted().
 *
 * Adds the 'card' CSS class to every task list row so the makerspace_gin
 * theme's auto-grid card layout kicks in without any View config changes.
 */
function makehaven_tasks_preprocess_views_view_unformatted(&$variables) {
  if ($variables['view']->id() !== 'tasks') {
    return;
  }
  foreach ($variables['rows'] as &$row) {
    $row['attributes']->addClass('card');
  }
}

/**
 * Implements hook_preprocess_views_view_table().
 *
 * Adds data attributes to each table row with claim/status info so the
 * client-side JS can render face badges on the task cards.
 */
function makehaven_tasks_preprocess_views_view_table(&$variables) {
  $view = $variables['view'];
  if ($view->id() !== 'tasks') {
    return;
  }

  $claim_data = [];
  foreach ($view->result as $index => $result_row) {
    $nid = $result_row->nid ?? NULL;
    if (!$nid) {
      continue;
    }
    $node = \Drupal\node\Entity\Node::load($nid);
    if (!$node || $node->bundle() !== 'task') {
      continue;
    }

    $status = $node->hasField('field_task_status') ? ($node->get('field_task_status')->value ?? 'open') : 'open';
    $entry = ['status' => $status];

    if ($status === 'in_progress' && $node->hasField('field_task_claimed_by') && !$node->get('field_task_claimed_by')->isEmpty()) {
      $claimer = $node->get('field_task_claimed_by')->entity;
      if ($claimer) {
        $entry['claimer'] = $claimer->getDisplayName();
        $entry['claimer_url'] = '/user/' . $claimer->id();
        // Get initials for avatar.
        $words = explode(' ', trim($claimer->getDisplayName()));
        $initials = '';
        foreach ($words as $w) {
          $initials .= mb_strtoupper(mb_substr($w, 0, 1));
        }
        $entry['initials'] = mb_substr($initials, 0, 2);
      }
    }

    if ($node->hasField('field_task_estimated_hours') && !$node->get('field_task_estimated_hours')->isEmpty()) {
      $hours = (float) $node->get('field_task_estimated_hours')->value;
      $entry['est'] = $hours < 1 ? (int) ($hours * 60) . ' min' : number_format($hours, 1) . ' hr';
    }

    $claim_data[$index] = $entry;
  }

  // Pass data to JS via drupalSettings.
  $variables['#attached']['drupalSettings']['makehavenTasks']['cardMeta'] = $claim_data;
}

/**
 * Implements hook_preprocess_views_view_fields().
 *
 * Appends meta badges (status, claimed-by, estimated time, category) to each
 * task card row so members can see at a glance who is working on what.
 */
function makehaven_tasks_preprocess_views_view_fields(&$variables) {
  if ($variables['view']->id() !== 'tasks') {
    return;
  }

  $nid = $variables['row']->nid ?? NULL;
  if (!$nid) {
    return;
  }

  $node = \Drupal\node\Entity\Node::load($nid);
  if (!$node || $node->bundle() !== 'task') {
    return;
  }

  $status = $node->hasField('field_task_status') ? $node->get('field_task_status')->value : 'open';
  $claimed_uid = $node->hasField('field_task_claimed_by') && !$node->get('field_task_claimed_by')->isEmpty()
    ? $node->get('field_task_claimed_by')->target_id
    : NULL;

  $badges = '';

  // Status / claimed-by badge.
  if ($status === 'in_progress' && $claimed_uid) {
    $badges .= _makehaven_tasks_render_face((int) $claimed_uid, (string) t('Claimed'), 'sm');
  }
  elseif ($status === 'incomplete') {
    $badges .= '<span class="task-card-badge task-card-incomplete">⚠ Needs attention</span>';
  }

  // Estimated time.
  if ($node->hasField('field_task_estimated_hours') && !$node->get('field_task_estimated_hours')->isEmpty()) {
    $hours = (float) $node->get('field_task_estimated_hours')->value;
    $label = $hours < 1 ? (int) ($hours * 60) . ' min' : number_format($hours, 1) . ' hr';
    $badges .= '<span class="task-card-badge task-card-time">⏱ ~' . $label . '</span>';
  }

  // Category.
  if ($node->hasField('field_task_category') && !$node->get('field_task_category')->isEmpty()) {
    $cat = htmlspecialchars(ucfirst($node->get('field_task_category')->value), ENT_QUOTES, 'UTF-8');
    $badges .= '<span class="task-card-badge task-card-category">' . $cat . '</span>';
  }

  // Always inject badges (even if empty, so the action row still renders).
  $badges_html = $badges ? '<div class="task-card-meta">' . $badges . '</div>' : '';

  // Action buttons — shown to authenticated users.
  $account = \Drupal::currentUser();
  $actions_html = '';
  if ($account->isAuthenticated()) {
    $flag_service = \Drupal::service('flag');
    $flag = $flag_service->getFlagById('task_completed');
    $already_done = $flag && $flag_service->getFlagging($flag, $node);

    if (!$already_done) {
      $current_uid = $account->id();
      $is_claimed_by_me = $claimed_uid && $claimed_uid == $current_uid;
      $token = \Drupal::csrfToken()->get("task-action/{$nid}");
      $claim_url = \Drupal\Core\Url::fromRoute('makehaven_tasks.claim', ['node' => $nid], [
        'query' => ['token' => $token],
      ])->toString();
      $node_url = \Drupal\Core\Url::fromRoute('entity.node.canonical', ['node' => $nid])->toString();

      $actions_html = '<div class="task-card-actions">';

      if ($status === 'incomplete') {
        $actions_html .= '<a href="' . $claim_url . '" class="task-action-btn">Pick this up</a>';
      } elseif (!$is_claimed_by_me) {
        $actions_html .= '<a href="' . $claim_url . '" class="task-action-btn">Claim task</a>';
      } else {
        $actions_html .= '<span class="task-card-badge task-card-inprogress">✓ Claimed by you</span>';
      }

      $actions_html .= ' <a href="' . $node_url . '" class="task-card-details-link">Details →</a>';
      $actions_html .= '</div>';
    }
  }

  if (!$badges_html && !$actions_html) {
    return;
  }

  // Helper to create a pseudo field in the views fields array.
  $make_pseudo = function (string $html, string $class): \stdClass {
    $pseudo = new \stdClass();
    $pseudo->handler = NULL;
    $pseudo->inline = FALSE;
    $pseudo->wrapper_element = 'div';
    $pseudo->label = '';
    $pseudo->label_html = '';
    $pseudo->content = \Drupal\Core\Render\Markup::create($html);
    $pseudo->raw = NULL;
    $pseudo->class = $class;
    $pseudo->separator = '';
    $pseudo->element_type = '';
    $pseudo->empty = FALSE;
    $pseudo->rewrite = FALSE;
    $pseudo->wrapper_attributes = new \Drupal\Core\Template\Attribute(['class' => ['views-field', $class]]);
    return $pseudo;
  };

  if ($badges_html) {
    $variables['fields']['task_meta_badges'] = $make_pseudo($badges_html, 'views-field-task-meta');
  }
  if ($actions_html) {
    $variables['fields']['task_card_actions'] = $make_pseudo($actions_html, 'views-field-task-actions');
  }
}

/**
 * Sends a Slack notification when a task is completed.
 */
function _makehaven_tasks_notify_slack($flagging) {
  $node = $flagging->getFlaggable();
  $user = $flagging->getOwner();

  // Load Slack webhook URL from Slack Connector configuration.
  $connector_config = \Drupal::config('slack_connector.settings');
  $webhook_url = $connector_config->get('webhook_url');
  if (empty($webhook_url)) {
    \Drupal::logger('makehaven_tasks')->error('Slack webhook URL is not configured in Slack Connector.');
    return;
  }

  // Default channel.
  $default_channel = '#tasks';

  // Get task title.
  $title = $node->label();

  // Generate an absolute URL for the node.
  $node_url = Url::fromRoute('entity.node.canonical', ['node' => $node->id()], ['absolute' => TRUE])->toString();

  // User name — Slack ID lives on the profile entity, not the user.
  $completed_by = $user->getDisplayName();
  $slack_id = _makehaven_tasks_get_slack_id($user);
  $mention = $slack_id ? " (by <@{$slack_id}>)" : " (by {$completed_by})";

  // Build an array of channels to post to (same logic as poster)
  $channels = [$default_channel];

  // Check if the Task has a referenced "item" via field_task_equipment.
  if ($node->hasField('field_task_equipment') && !$node->get('field_task_equipment')->isEmpty()) {
    $item_node = $node->get('field_task_equipment')->entity;
    if ($item_node) {
      if ($item_node->hasField('field_item_slack_channel') && !$item_node->get('field_item_slack_channel')->isEmpty()) {
        $channel_name = $item_node->get('field_item_slack_channel')->value;
        $channels[] = '#' . ltrim($channel_name, '#');
      }
      if ($item_node->hasField('field_item_area_interest') && !$item_node->get('field_item_area_interest')->isEmpty()) {
        $terms = $item_node->get('field_item_area_interest')->referencedEntities();
        foreach ($terms as $term) {
          if ($term->hasField('field_interest_slack_channel') && !$term->get('field_interest_slack_channel')->isEmpty()) {
            $channel_name = $term->get('field_interest_slack_channel')->value;
            $channels[] = '#' . ltrim($channel_name, '#');
          }
        }
      }
    }
  }

  $channels = array_unique($channels);

  $message_text = "✅ Task Completed: '{$title}' {$mention} 
View Task: {$node_url}";

  $client = \Drupal::httpClient();
  foreach ($channels as $channel) {
    $data = [
      'channel' => $channel,
      'blocks' => [
        [
          'type' => 'section',
          'text' => [
            'type' => 'mrkdwn',
            'text' => $message_text,
          ],
        ],
      ],
    ];

    try {
      $client->post($webhook_url, [
        'headers' => ['Content-Type' => 'application/json'],
        'json' => $data,
      ]);
      \Drupal::logger('makehaven_tasks')->notice('Slack notification sent to @channel for task completion.', ['@channel' => $channel]);
    }
    catch (\Exception $e) {
      \Drupal::logger('makehaven_tasks')->error('Error posting to Slack: @error', ['@error' => $e->getMessage()]);
    }
  }
}

// ── Recognition helpers ────────────────────────────────────────────────────

/**
 * Returns the total number of tasks a user has completed (flagging count).
 */
function _makehaven_tasks_user_completion_count(int $uid): int {
  $table = \Drupal::entityTypeManager()
    ->getDefinition('flagging')
    ->getBaseTable();
  return (int) \Drupal::database()
    ->select($table, 'f')
    ->condition('f.flag_id', 'task_completed')
    ->condition('f.uid', $uid)
    ->countQuery()
    ->execute()
    ->fetchField();
}

/**
 * Posts a Slack milestone celebration when a user crosses 10/25/50/100 tasks.
 */
function _makehaven_tasks_check_milestone(\Drupal\flag\FlaggingInterface $flagging): void {
  $user = $flagging->getOwner();
  $uid = (int) $user->id();
  $count = _makehaven_tasks_user_completion_count($uid);

  $milestones = [10, 25, 50, 100];
  if (!in_array($count, $milestones, TRUE)) {
    return;
  }

  $webhook_url = \Drupal::config('slack_connector.settings')->get('webhook_url');
  if (empty($webhook_url)) {
    return;
  }

  $slack_id = _makehaven_tasks_get_slack_id($user);
  $mention = $slack_id ? "<@{$slack_id}>" : '*' . $user->getDisplayName() . '*';

  $messages = [
    10  => "🎉 {$mention} just completed their *10th task*! Thank you for contributing to MakeHaven!",
    25  => "🌟 Amazing! {$mention} has now completed *25 tasks*! MakeHaven runs because of people like you!",
    50  => "🏆 *MILESTONE!* {$mention} has completed *50 tasks* — a true MakeHaven hero! 🙌",
    100 => "👑 *LEGENDARY!* {$mention} has completed *100 tasks*! The MakeHaven Hall of Fame awaits!",
  ];

  $text = $messages[$count];
  $lb_url = \Drupal\Core\Url::fromRoute('makehaven_tasks.leaderboard', [], ['absolute' => TRUE])->toString();
  $text .= "\n<{$lb_url}|View the leaderboard>";

  try {
    \Drupal::httpClient()->post($webhook_url, [
      'headers' => ['Content-Type' => 'application/json'],
      'json' => [
        'channel' => '#tasks',
        'blocks' => [[
          'type' => 'section',
          'text' => ['type' => 'mrkdwn', 'text' => $text],
        ]],
      ],
    ]);
  }
  catch (\Exception $e) {
    \Drupal::logger('makehaven_tasks')->error('Milestone Slack notification failed: @error', ['@error' => $e->getMessage()]);
  }
}

/**
 * Creates a maintenance log entry when a task linked to equipment is completed.
 *
 * This gives the asset history a record that a maintenance task was done,
 * without changing the asset's status (staff still controls that separately).
 */
function _makehaven_tasks_write_maintenance_log(\Drupal\flag\FlaggingInterface $flagging): void {
  $node = $flagging->getFlaggable();
  if (!$node instanceof \Drupal\node\NodeInterface || $node->bundle() !== 'task') {
    return;
  }

  if (!$node->hasField('field_task_equipment') || $node->get('field_task_equipment')->isEmpty()) {
    return;
  }

  $item_node = $node->get('field_task_equipment')->entity;
  if (!$item_node instanceof \Drupal\node\NodeInterface) {
    return;
  }

  $user = $flagging->getOwner();
  $task_title = $node->label();

  // Build a details string from the task body if present.
  $details = '';
  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $details = strip_tags($node->get('body')->value ?? '');
    $details = mb_substr($details, 0, 800);
  }

  try {
    /** @var \Drupal\Core\Entity\EntityStorageInterface $storage */
    $storage = \Drupal::entityTypeManager()->getStorage('asset_log_entry');
    $entry = $storage->create([
      'type'    => 'maintenance',
      'asset'   => $item_node->id(),
      'summary' => 'Task completed: ' . mb_substr($task_title, 0, 220),
      'details' => $details ?: NULL,
      'user_id' => $user->id(),
      'status'  => TRUE,
    ]);
    // Prevent the asset_status entity hooks from double-logging this entry.
    $entry->_skip_asset_status_log = TRUE;
    $entry->save();
  }
  catch (\Exception $e) {
    \Drupal::logger('makehaven_tasks')->error(
      'Could not write maintenance log for task @nid on item @item: @error',
      ['@nid' => $node->id(), '@item' => $item_node->id(), '@error' => $e->getMessage()]
    );
  }
}