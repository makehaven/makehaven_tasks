/**
 * Fix stale help text, unhide field_task_audience on the task form.
 */
function makehaven_tasks_update_9004() {
  $field_descriptions = [
    'field.field.node.task.field_task_frequency' => 'How often this task recurs. Set a frequency and a Next Due date (leave Series Source empty) to create a recurring series — the cron job will generate new occurrences automatically.',
    'field.field.node.task.field_task_next_due' => 'When the first (or next) occurrence should become active. Required for recurring tasks. Leave blank for one-off tasks.',
    'field.field.node.task.field_task_series_source' => 'Set automatically on generated occurrences. Leave empty when creating a new recurring series template.',
  ];

  foreach ($field_descriptions as $config_name => $description) {
    $field_config = \Drupal::configFactory()->getEditable($config_name);
    if (!$field_config->isNew()) {
      $field_config->set('description', $description)->save();
    }
  }

  // Unhide field_task_audience on the default task form display.
  //
  // Some environments have partially malformed form display config where the
  // entity save path triggers a uasort() warning on a NULL component list.
  // Update the raw config defensively so the hook remains idempotent and does
  // not block later updates.
  $form_display = \Drupal::configFactory()->getEditable('core.entity_form_display.node.task.default');
  if (!$form_display->isNew()) {
    $content = $form_display->get('content');
    if (!is_array($content)) {
      $content = [];
    }

    if (empty($content['field_task_audience'])) {
      $content['field_task_audience'] = [
        'type' => 'options_select',
        'weight' => 4,
        'region' => 'content',
        'settings' => [],
        'third_party_settings' => [],
      ];
      $form_display->set('content', $content);
    }

    $hidden = $form_display->get('hidden');
    if (!is_array($hidden)) {
      $hidden = [];
    }
    if (array_key_exists('field_task_audience', $hidden)) {
      unset($hidden['field_task_audience']);
      $form_display->set('hidden', $hidden);
    }

    $form_display->save();
  }

  return t('Fixed field help text and unhid field_task_audience on task form.');
}

/**
 * Grant tiered task permissions to member, facilitator, and staff roles.
 *
 * Members:      create_from_bank (bank-only task creation)
 * Facilitators: create_from_bank + create_task (ad-hoc task creation)
 * Staff:        all of the above + manage_bank + manage_tasks
 */
function makehaven_tasks_update_9005() {
  $role_storage = \Drupal::entityTypeManager()->getStorage('user_role');

  // All logged-in users can create from bank. Granting on `authenticated`
  // covers members, facilitators, and staff (they all inherit this role).
  $auth = $role_storage->load('authenticated');
  if ($auth) {
    $auth->grantPermission('makehaven_tasks.create_from_bank');
    $auth->save();
  }

  // Facilitators: can create from bank + create ad-hoc tasks.
  $facilitator = $role_storage->load('facilitator');
  if ($facilitator) {
    $facilitator->grantPermission('makehaven_tasks.create_from_bank');
    $facilitator->grantPermission('makehaven_tasks.create_task');
    $facilitator->save();
  }

  // Staff roles: full task management.
  foreach (['administrator', 'manager', 'content_editor'] as $rid) {
    $role = $role_storage->load($rid);
    if ($role) {
      $role->grantPermission('makehaven_tasks.create_from_bank');
      $role->grantPermission('makehaven_tasks.create_task');
      $role->grantPermission('makehaven_tasks.manage_bank');
      $role->grantPermission('makehaven_tasks.manage_tasks');
      $role->save();
    }
  }

  return t('Granted tiered task permissions to member, facilitator, and staff roles.');
}

/**
 * Add field_task_helpers and field_task_allow_multiple.
 *
 * Single-claim is now the default: one member is the lead (field_task_claimed_by)
 * and others can "offer to help" — tracked in field_task_helpers (multi-value
 * user ref). Tasks that genuinely suit several independent claimants can opt in
 * via field_task_allow_multiple, in which case every participant is treated as a
 * co-claimant with no single lead.
 */
function makehaven_tasks_update_9006() {
  $messages = [];

  // 1. field_task_helpers — members who offered to help the lead (or, on
  //    allow-multiple tasks, the co-claimants). Unlimited cardinality.
  if (!FieldStorageConfig::loadByName('node', 'field_task_helpers')) {
    FieldStorageConfig::create([
      'field_name' => 'field_task_helpers',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => ['target_type' => 'user'],
      'cardinality' => FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'task', 'field_task_helpers')) {
    FieldConfig::create([
      'field_name' => 'field_task_helpers',
      'entity_type' => 'node',
      'bundle' => 'task',
      'label' => 'Helpers',
      'required' => FALSE,
      'description' => 'Members who offered to help the lead. Managed by the "Offer to help" button — not edited directly.',
      'settings' => [
        'handler' => 'default:user',
        'handler_settings' => ['filter' => [], 'sort' => [], 'auto_create' => FALSE],
      ],
    ])->save();
    $messages[] = 'field_task_helpers';
  }

  // 2. field_task_allow_multiple — per-task opt-in to multi-claim.
  if (!FieldStorageConfig::loadByName('node', 'field_task_allow_multiple')) {
    FieldStorageConfig::create([
      'field_name' => 'field_task_allow_multiple',
      'entity_type' => 'node',
      'type' => 'boolean',
      'cardinality' => 1,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'task', 'field_task_allow_multiple')) {
    FieldConfig::create([
      'field_name' => 'field_task_allow_multiple',
      'entity_type' => 'node',
      'bundle' => 'task',
      'label' => 'Allow multiple people to claim',
      'required' => FALSE,
      'default_value' => [['value' => 0]],
      'description' => 'Off (default): the first person becomes the lead and others can offer to help. On: several members can each claim independently — use for tasks like "everyone wipe down a bench".',
      'settings' => ['on_label' => 'Yes', 'off_label' => 'No'],
    ])->save();
    $messages[] = 'field_task_allow_multiple';

    // Surface the checkbox on the task form, just under "Who can claim".
    $form_display = \Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->load('node.task.default');
    if ($form_display) {
      $form_display->setComponent('field_task_allow_multiple', [
        'type' => 'boolean_checkbox',
        'weight' => 6,
        'region' => 'content',
        'settings' => ['display_label' => TRUE],
        'third_party_settings' => [],
      ])->save();
    }
  }

  return t('Added @fields.', ['@fields' => $messages ? implode(', ', $messages) : 'no new fields (already present)']);
}

/**
 * Volunteer board, phase 1: opportunity fields, sign-up table, settings.
 *
 * Adds stage, kind, when, volunteers needed/most, decide-by, decision note
 * and interest area to the task type, all optional: an empty stage reads as
 * approved, so every existing task is untouched. Adds the
 * makehaven_task_signup table and the new makehaven_tasks.settings keys.
 */
function makehaven_tasks_update_9007() {
  $created = _makehaven_tasks_install_volunteer_fields();

  $config = \Drupal::configFactory()->getEditable('makehaven_tasks.settings');
  $defaults = [
    'volunteer_slack_channel' => '#volunteers',
    'ready_to_approve_email' => 'staff@makehaven.org',
    'gathering_days' => 8,
    'short_reminder_days' => 3,
    'member_suggestion_stage' => 'gathering',
    'stale_first_days' => 14,
    'stale_second_days' => 28,
  ];
  $set = [];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
      $set[] = $key;
    }
  }
  if ($set) {
    $config->save();
  }

  return t('Volunteer board: created @fields; set @settings.', [
    '@fields' => $created ? implode(', ', $created) : 'no new fields (already present)',
    '@settings' => $set ? implode(', ', $set) : 'no new settings',
  ]);
}

/**
 * Reads a config object from the site's sync directory, else the module copy.
 *
 * Storage changes made by update hooks match what is exported, so a later
 * `drush cim` sees no difference.
 */
function _makehaven_tasks_read_config(string $name): ?array {
  try {
    $sync = \Drupal::service('config.storage.sync');
    if ($sync->exists($name)) {
      return $sync->read($name) ?: NULL;
    }
  }
  catch (\Throwable $e) {
  }
  $module_storage = new FileStorage(\Drupal::service('extension.list.module')->getPath('makehaven_tasks') . '/config/optional');
  return $module_storage->read($name) ?: NULL;
}

/**
 * Volunteer board phase 2 (1 of 4): sign-up slots and the thank-you ledger.
 */
function makehaven_tasks_update_9008() {
  $done = [];
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('makehaven_task_signup') && !$schema->fieldExists('makehaven_task_signup', 'slot')) {
    $schema->addField('makehaven_task_signup', 'slot', makehaven_tasks_schema()['makehaven_task_signup']['fields']['slot']);
  }
  if ($schema->tableExists('makehaven_task_signup') && $schema->indexExists('makehaven_task_signup', 'nid_uid')) {
    $schema->dropUniqueKey('makehaven_task_signup', 'nid_uid');
    $schema->addUniqueKey('makehaven_task_signup', 'nid_uid_slot', ['nid', 'uid', 'slot']);
    $done[] = 'sign-ups record their time slot';
  }
  if (!$schema->tableExists('makehaven_volunteer_perk')) {
    $schema->createTable('makehaven_volunteer_perk', makehaven_tasks_schema()['makehaven_volunteer_perk']);
    $done[] = 'thank-you ledger';
  }

  $config = \Drupal::configFactory()->getEditable('makehaven_tasks.settings');
  $defaults = [
    'perk_lunch_amount' => 15,
    'perk_lunch_hours' => 3,
    'perk_hoodie_dates' => 5,
    'perk_tshirt_material' => 19384,
    'perk_hoodie_material' => 41386,
    'outreach_slack_channel' => '#outreach-retention-committee',
  ];
  $set = [];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
      $set[] = $key;
    }
  }
  if ($set) {
    $config->save();
    $done[] = 'settings ' . implode(', ', $set);
  }
  return t('Volunteer board: @done.', ['@done' => $done ? implode('; ', $done) : 'nothing to do']);
}

/**
 * Volunteer board phase 2 (2 of 4): time slots and the tabling type.
 *
 * field_task_when becomes multi-value (one item per slot); field_task_type
 * gains "tabling".
 */
function makehaven_tasks_update_9009() {
  $done = [];
  \Drupal\Component\Utility\Environment::setTimeLimit(300);
  $when = FieldStorageConfig::load('node.field_task_when');
  if ($when && $when->getCardinality() !== FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED) {
    $when->setCardinality(FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED);
    $when->save();
    $done[] = 'several time slots per opportunity';
  }
  \Drupal\Component\Utility\Environment::setTimeLimit(300);
  $type = FieldStorageConfig::load('node.field_task_type');
  if ($type) {
    // The entity API holds list values as value => label.
    $allowed = $type->getSetting('allowed_values');
    if (!isset($allowed['tabling'])) {
      $allowed['tabling'] = 'Tabling (representing MakeHaven at an outside event)';
      $type->setSetting('allowed_values', $allowed);
      $type->save();
      $done[] = 'tabling type';
    }
  }
  $field = FieldConfig::load('node.task.field_task_when');
  $wanted = _makehaven_tasks_read_config('field.field.node.task.field_task_when');
  if ($field && $wanted && $field->getDescription() !== $wanted['description']) {
    $field->setDescription($wanted['description'])->save();
  }
  return t('Volunteer board: @done.', ['@done' => $done ? implode('; ', $done) : 'nothing to do']);
}

/**
 * Volunteer board phase 2 (3 of 4): the tabling fields.
 */
function makehaven_tasks_update_9010() {
  $created = _makehaven_tasks_install_volunteer_fields();
  return t('Volunteer board: @fields.', ['@fields' => $created ? 'created ' . implode(', ', $created) : 'tabling fields already present']);
}

/**
 * Volunteer board phase 2 (4 of 4): "Volunteer appreciation" store reason.
 *
 * Giving a volunteer a t-shirt or hoodie records a store inventory
 * adjustment with this reason, so the shelf count stays right.
 */
function makehaven_tasks_update_9011() {
  \Drupal\Component\Utility\Environment::setTimeLimit(300);
  $reason = FieldStorageConfig::load('material_inventory.field_inventory_change_reason');
  if (!$reason) {
    return t('No store inventory reasons on this site; skipped.');
  }
  // The entity API holds list values as value => label.
  $allowed = $reason->getSetting('allowed_values');
  if (isset($allowed['volunteer_appreciation'])) {
    return t('Store reason already present.');
  }
  $allowed['volunteer_appreciation'] = 'Volunteer appreciation';
  $reason->setSetting('allowed_values', $allowed);
  $reason->save();
  return t('Added store inventory reason "Volunteer appreciation".');
}

/**
 * Claim check-in: "How's it going?" a week after a task is claimed.
 *
 * Adds checkin_days (7) and checkin_cc (the "ready to approve" address,
 * staff@makehaven.org) to makehaven_tasks.settings. No mail is sent here, and
 * the first cron after it only mails claims between 7 and 14 days old.
 */
function makehaven_tasks_update_9012() {
  $config = \Drupal::configFactory()->getEditable('makehaven_tasks.settings');
  $set = [];
  if ($config->get('checkin_days') === NULL) {
    $config->set('checkin_days', 7);
    $set[] = 'checkin_days';
  }
  if ($config->get('checkin_cc') === NULL) {
    $config->set('checkin_cc', (string) ($config->get('ready_to_approve_email') ?: 'staff@makehaven.org'));
    $set[] = 'checkin_cc';
  }
  if ($set) {
    $config->save();
  }
  return t('Claim check-in: @set.', ['@set' => $set ? 'set ' . implode(', ', $set) : 'settings already present']);
}
