<?php

/**
 * @file
 * Install and update hooks for the MakeHaven Tasks module.
 */

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * Phase 1 enhancements: add category, biennial frequency, instructions, video.
 *
 * Adds:
 *   - field_task_category (list_string)
 *   - field_task_instructions (text_long)
 *   - field_task_video_url (link)
 *   - biennial value to field_task_frequency allowed values
 */
function makehaven_tasks_update_9001() {
  // 1. Add biennial to field_task_frequency allowed values.
  // The allowed_values setting is a flat key => label array.
  $frequency_storage = FieldStorageConfig::loadByName('node', 'field_task_frequency');
  if ($frequency_storage && !isset($frequency_storage->getSetting('allowed_values')['biennial'])) {
    $allowed_values = $frequency_storage->getSetting('allowed_values');
    // Insert biennial before 'archive' if present, otherwise append.
    if (array_key_exists('archive', $allowed_values)) {
      $new_values = [];
      foreach ($allowed_values as $key => $label) {
        if ($key === 'archive') {
          $new_values['biennial'] = 'Biennial (every 2 years)';
        }
        $new_values[$key] = $label;
      }
      $allowed_values = $new_values;
    }
    else {
      $allowed_values['biennial'] = 'Biennial (every 2 years)';
    }
    $frequency_storage->setSetting('allowed_values', $allowed_values);
    $frequency_storage->save();
  }

  // 2. Add field_task_category.
  if (!FieldStorageConfig::loadByName('node', 'field_task_category')) {
    FieldStorageConfig::create([
      'field_name' => 'field_task_category',
      'entity_type' => 'node',
      'type' => 'list_string',
      'settings' => [
        'allowed_values' => [
          'cleaning' => 'Cleaning',
          'maintenance' => 'Maintenance',
          'inspection' => 'Inspection',
          'restocking' => 'Restocking',
          'other' => 'Other',
        ],
      ],
      'cardinality' => 1,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'task', 'field_task_category')) {
    FieldConfig::create([
      'field_name' => 'field_task_category',
      'entity_type' => 'node',
      'bundle' => 'task',
      'label' => 'Category',
      'required' => FALSE,
    ])->save();

    // Add to default form display.
    $form_display = \Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->load('node.task.default');
    if ($form_display) {
      $form_display->setComponent('field_task_category', [
        'type' => 'options_select',
        'weight' => 5,
      ])->save();
    }

    // Add to default view display.
    $view_display = \Drupal::entityTypeManager()
      ->getStorage('entity_view_display')
      ->load('node.task.default');
    if ($view_display) {
      $view_display->setComponent('field_task_category', [
        'type' => 'list_default',
        'label' => 'inline',
        'weight' => 5,
      ])->save();
    }
  }

  // 3. Add field_task_instructions (rich text).
  if (!FieldStorageConfig::loadByName('node', 'field_task_instructions')) {
    FieldStorageConfig::create([
      'field_name' => 'field_task_instructions',
      'entity_type' => 'node',
      'type' => 'text_long',
      'cardinality' => 1,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'task', 'field_task_instructions')) {
    FieldConfig::create([
      'field_name' => 'field_task_instructions',
      'entity_type' => 'node',
      'bundle' => 'task',
      'label' => 'Instructions',
      'required' => FALSE,
      'description' => 'Step-by-step procedure, supply locations, and safety notes. Set on the template; displayed on each occurrence.',
    ])->save();

    $form_display = \Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->load('node.task.default');
    if ($form_display) {
      $form_display->setComponent('field_task_instructions', [
        'type' => 'text_textarea',
        'weight' => 10,
        'settings' => ['rows' => 6],
      ])->save();
    }

    $view_display = \Drupal::entityTypeManager()
      ->getStorage('entity_view_display')
      ->load('node.task.default');
    if ($view_display) {
      $view_display->setComponent('field_task_instructions', [
        'type' => 'text_default',
        'label' => 'above',
        'weight' => 10,
      ])->save();
    }
  }

  // 4. Add field_task_video_url (link field).
  if (!FieldStorageConfig::loadByName('node', 'field_task_video_url')) {
    FieldStorageConfig::create([
      'field_name' => 'field_task_video_url',
      'entity_type' => 'node',
      'type' => 'link',
      'cardinality' => 1,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'task', 'field_task_video_url')) {
    FieldConfig::create([
      'field_name' => 'field_task_video_url',
      'entity_type' => 'node',
      'bundle' => 'task',
      'label' => 'Instructional Video',
      'required' => FALSE,
      'description' => 'Optional link to a tutorial or how-to video for this task.',
      'settings' => [
        'link_type' => \Drupal\link\LinkItemInterface::LINK_EXTERNAL,
        'title' => DRUPAL_OPTIONAL,
      ],
    ])->save();

    $form_display = \Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->load('node.task.default');
    if ($form_display) {
      $form_display->setComponent('field_task_video_url', [
        'type' => 'link_default',
        'weight' => 11,
        'settings' => ['placeholder_url' => 'https://...', 'placeholder_title' => ''],
      ])->save();
    }

    $view_display = \Drupal::entityTypeManager()
      ->getStorage('entity_view_display')
      ->load('node.task.default');
    if ($view_display) {
      $view_display->setComponent('field_task_video_url', [
        'type' => 'link',
        'label' => 'above',
        'weight' => 11,
        'settings' => [
          'trim_length' => 80,
          'url_only' => FALSE,
          'url_plain' => FALSE,
          'rel' => '',
          'target' => '_blank',
        ],
      ])->save();
    }
  }

  return t('Phase 1: Added task category, biennial frequency, instructions, and video URL fields.');
}

/**
 * Phase 3: Add field_task_status and field_task_claimed_by.
 */
function makehaven_tasks_update_9002() {
  // 1. field_task_status (list_string: open, in_progress, incomplete).
  if (!FieldStorageConfig::loadByName('node', 'field_task_status')) {
    FieldStorageConfig::create([
      'field_name' => 'field_task_status',
      'entity_type' => 'node',
      'type' => 'list_string',
      'settings' => [
        'allowed_values' => [
          'open' => 'Open',
          'in_progress' => 'In Progress',
          'incomplete' => 'Incomplete — needs attention',
        ],
      ],
      'cardinality' => 1,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'task', 'field_task_status')) {
    FieldConfig::create([
      'field_name' => 'field_task_status',
      'entity_type' => 'node',
      'bundle' => 'task',
      'label' => 'Status',
      'required' => FALSE,
      'default_value' => [['value' => 'open']],
      'description' => 'Pre-completion state. "complete" is tracked by the task_completed flag, not this field.',
    ])->save();

    $form_display = \Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->load('node.task.default');
    if ($form_display) {
      $form_display->setComponent('field_task_status', [
        'type' => 'options_select',
        'weight' => 6,
      ])->save();
    }

    $view_display = \Drupal::entityTypeManager()
      ->getStorage('entity_view_display')
      ->load('node.task.default');
    if ($view_display) {
      $view_display->setComponent('field_task_status', [
        'type' => 'list_default',
        'label' => 'inline',
        'weight' => 6,
      ])->save();
    }
  }

  // 2. field_task_claimed_by (user reference — who is actively working on it).
  if (!FieldStorageConfig::loadByName('node', 'field_task_claimed_by')) {
    FieldStorageConfig::create([
      'field_name' => 'field_task_claimed_by',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => ['target_type' => 'user'],
      'cardinality' => 1,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'task', 'field_task_claimed_by')) {
    FieldConfig::create([
      'field_name' => 'field_task_claimed_by',
      'entity_type' => 'node',
      'bundle' => 'task',
      'label' => 'Claimed by',
      'required' => FALSE,
      'description' => 'Set when a member marks this task as in-progress.',
      'settings' => [
        'handler' => 'default:user',
        'handler_settings' => ['filter' => [], 'sort' => [], 'auto_create' => FALSE],
      ],
    ])->save();

    $form_display = \Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->load('node.task.default');
    if ($form_display) {
      $form_display->setComponent('field_task_claimed_by', [
        'type' => 'entity_reference_autocomplete',
        'weight' => 7,
      ])->save();
    }

    $view_display = \Drupal::entityTypeManager()
      ->getStorage('entity_view_display')
      ->load('node.task.default');
    if ($view_display) {
      $view_display->setComponent('field_task_claimed_by', [
        'type' => 'entity_reference_label',
        'label' => 'inline',
        'weight' => 7,
      ])->save();
    }
  }

  return t('Phase 3: Added field_task_status and field_task_claimed_by.');
}

/**
 * Phase 4: Add field_task_estimated_hours.
 */
function makehaven_tasks_update_9003() {
  if (!FieldStorageConfig::loadByName('node', 'field_task_estimated_hours')) {
    FieldStorageConfig::create([
      'field_name' => 'field_task_estimated_hours',
      'entity_type' => 'node',
      'type' => 'float',
      'cardinality' => 1,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'task', 'field_task_estimated_hours')) {
    FieldConfig::create([
      'field_name' => 'field_task_estimated_hours',
      'entity_type' => 'node',
      'bundle' => 'task',
      'label' => 'Estimated hours',
      'required' => FALSE,
      'default_value' => [['value' => 0.5]],
      'description' => 'Approximate time to complete. Used for volunteer hour reporting and workload planning. Leave blank if unknown.',
    ])->save();

    $form_display = \Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->load('node.task.default');
    if ($form_display) {
      $form_display->setComponent('field_task_estimated_hours', [
        'type' => 'number',
        'weight' => 8,
        'settings' => ['placeholder' => '0.5'],
      ])->save();
    }

    $view_display = \Drupal::entityTypeManager()
      ->getStorage('entity_view_display')
      ->load('node.task.default');
    if ($view_display) {
      $view_display->setComponent('field_task_estimated_hours', [
        'type' => 'number_decimal',
        'label' => 'inline',
        'weight' => 8,
        'settings' => ['decimal_separator' => '.', 'scale' => 1, 'thousand_separator' => '', 'prefix_suffix' => TRUE],
      ])->save();
    }
  }

  return t('Phase 4: Added field_task_estimated_hours.');
}

/**
 * Fix stale help text, unhide field_task_audience on the task form.
 */
function makehaven_tasks_update_9004() {
  $field_descriptions = [
    'field.field.node.task.field_task_frequency' => 'How often this task recurs. Set a frequency and a Next Due date (leave Series Source empty) to create a recurring series — the cron job will generate new occurrences automatically.',
    'field.field.node.task.field_task_next_due' => 'When the first (or next) occurrence should become active. Required for recurring tasks. Leave blank for one-off tasks.',
    'field.field.node.task.field_task_series_source' => 'Set automatically on generated occurrences. Leave empty when creating a new recurring series template.',
  ];

  foreach ($field_descriptions as $config_name => $description) {
    $field_config = \Drupal::configFactory()->getEditable($config_name);
    if (!$field_config->isNew()) {
      $field_config->set('description', $description)->save();
    }
  }

  // Unhide field_task_audience on the default task form display.
  //
  // Some environments have partially malformed form display config where the
  // entity save path triggers a uasort() warning on a NULL component list.
  // Update the raw config defensively so the hook remains idempotent and does
  // not block later updates.
  $form_display = \Drupal::configFactory()->getEditable('core.entity_form_display.node.task.default');
  if (!$form_display->isNew()) {
    $content = $form_display->get('content');
    if (!is_array($content)) {
      $content = [];
    }

    if (empty($content['field_task_audience'])) {
      $content['field_task_audience'] = [
        'type' => 'options_select',
        'weight' => 4,
        'region' => 'content',
        'settings' => [],
        'third_party_settings' => [],
      ];
      $form_display->set('content', $content);
    }

    $hidden = $form_display->get('hidden');
    if (!is_array($hidden)) {
      $hidden = [];
    }
    if (array_key_exists('field_task_audience', $hidden)) {
      unset($hidden['field_task_audience']);
      $form_display->set('hidden', $hidden);
    }

    $form_display->save();
  }

  return t('Fixed field help text and unhid field_task_audience on task form.');
}

/**
 * Grant tiered task permissions to member, facilitator, and staff roles.
 *
 * Members:      create_from_bank (bank-only task creation)
 * Facilitators: create_from_bank + create_task (ad-hoc task creation)
 * Staff:        all of the above + manage_bank + manage_tasks
 */
function makehaven_tasks_update_9005() {
  $role_storage = \Drupal::entityTypeManager()->getStorage('user_role');

  // All logged-in users can create from bank. Granting on `authenticated`
  // covers members, facilitators, and staff (they all inherit this role).
  $auth = $role_storage->load('authenticated');
  if ($auth) {
    $auth->grantPermission('makehaven_tasks.create_from_bank');
    $auth->save();
  }

  // Facilitators: can create from bank + create ad-hoc tasks.
  $facilitator = $role_storage->load('facilitator');
  if ($facilitator) {
    $facilitator->grantPermission('makehaven_tasks.create_from_bank');
    $facilitator->grantPermission('makehaven_tasks.create_task');
    $facilitator->save();
  }

  // Staff roles: full task management.
  foreach (['administrator', 'manager', 'content_editor'] as $rid) {
    $role = $role_storage->load($rid);
    if ($role) {
      $role->grantPermission('makehaven_tasks.create_from_bank');
      $role->grantPermission('makehaven_tasks.create_task');
      $role->grantPermission('makehaven_tasks.manage_bank');
      $role->grantPermission('makehaven_tasks.manage_tasks');
      $role->save();
    }
  }

  return t('Granted tiered task permissions to member, facilitator, and staff roles.');
}

/**
 * Add field_task_helpers and field_task_allow_multiple.
 *
 * Single-claim is now the default: one member is the lead (field_task_claimed_by)
 * and others can "offer to help" — tracked in field_task_helpers (multi-value
 * user ref). Tasks that genuinely suit several independent claimants can opt in
 * via field_task_allow_multiple, in which case every participant is treated as a
 * co-claimant with no single lead.
 */
function makehaven_tasks_update_9006() {
  $messages = [];

  // 1. field_task_helpers — members who offered to help the lead (or, on
  //    allow-multiple tasks, the co-claimants). Unlimited cardinality.
  if (!FieldStorageConfig::loadByName('node', 'field_task_helpers')) {
    FieldStorageConfig::create([
      'field_name' => 'field_task_helpers',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => ['target_type' => 'user'],
      'cardinality' => FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'task', 'field_task_helpers')) {
    FieldConfig::create([
      'field_name' => 'field_task_helpers',
      'entity_type' => 'node',
      'bundle' => 'task',
      'label' => 'Helpers',
      'required' => FALSE,
      'description' => 'Members who offered to help the lead. Managed by the "Offer to help" button — not edited directly.',
      'settings' => [
        'handler' => 'default:user',
        'handler_settings' => ['filter' => [], 'sort' => [], 'auto_create' => FALSE],
      ],
    ])->save();
    $messages[] = 'field_task_helpers';
  }

  // 2. field_task_allow_multiple — per-task opt-in to multi-claim.
  if (!FieldStorageConfig::loadByName('node', 'field_task_allow_multiple')) {
    FieldStorageConfig::create([
      'field_name' => 'field_task_allow_multiple',
      'entity_type' => 'node',
      'type' => 'boolean',
      'cardinality' => 1,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'task', 'field_task_allow_multiple')) {
    FieldConfig::create([
      'field_name' => 'field_task_allow_multiple',
      'entity_type' => 'node',
      'bundle' => 'task',
      'label' => 'Allow multiple people to claim',
      'required' => FALSE,
      'default_value' => [['value' => 0]],
      'description' => 'Off (default): the first person becomes the lead and others can offer to help. On: several members can each claim independently — use for tasks like "everyone wipe down a bench".',
      'settings' => ['on_label' => 'Yes', 'off_label' => 'No'],
    ])->save();
    $messages[] = 'field_task_allow_multiple';

    // Surface the checkbox on the task form, just under "Who can claim".
    $form_display = \Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->load('node.task.default');
    if ($form_display) {
      $form_display->setComponent('field_task_allow_multiple', [
        'type' => 'boolean_checkbox',
        'weight' => 6,
        'region' => 'content',
        'settings' => ['display_label' => TRUE],
        'third_party_settings' => [],
      ])->save();
    }
  }

  return t('Added @fields.', ['@fields' => $messages ? implode(', ', $messages) : 'no new fields (already present)']);
}
