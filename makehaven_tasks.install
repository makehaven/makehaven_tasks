<?php

/**
 * @file
 * Install and update hooks for the MakeHaven Tasks module.
 */

use Drupal\Core\Config\FileStorage;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * Implements hook_schema().
 */
function makehaven_tasks_schema(): array {
  return [
    'makehaven_task_signup' => [
      'description' => 'Volunteer board: one row per person per task ("I\'m interested", then the roster).',
      'fields' => [
        'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
        'nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'description' => 'The task node.'],
        'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'description' => 'The volunteer.'],
        'note' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => '', 'description' => '"Saturdays only", "I can bring a truck".'],
        'kind' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'interest', 'description' => 'interest (gathering) or confirmed (approved).'],
        'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
        'slot' => ['type' => 'int', 'not null' => TRUE, 'default' => 0, 'description' => 'Start (Unix time) of the time slot signed up for; 0 for an undated task.'],
      ],
      'primary key' => ['id'],
      'unique keys' => ['nid_uid_slot' => ['nid', 'uid', 'slot']],
      'indexes' => ['uid' => ['uid']],
    ],
    'makehaven_volunteer_perk' => [
      'description' => 'Volunteer thank-yous handed out (t-shirt, lunch, hoodie), and dates marked as a no-show.',
      'fields' => [
        'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
        'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'description' => 'The volunteer.'],
        'perk' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'description' => 'tshirt, lunch, hoodie, or no_show.'],
        'ref' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => '', 'description' => 'Y-m-d for lunch and no_show; empty for the one-off t-shirt and hoodie.'],
        'nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0, 'description' => 'The opportunity it was earned on, when known.'],
        'status' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'given', 'description' => 'given or skipped (declined, already has one).'],
        'note' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => '', 'description' => 'Size, amount, or why skipped.'],
        'adjustment_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0, 'description' => 'The store inventory adjustment that took the item off the shelf.'],
        'by_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
        'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      ],
      'primary key' => ['id'],
      'unique keys' => ['uid_perk_ref' => ['uid', 'perk', 'ref']],
      'indexes' => ['perk' => ['perk']],
    ],
  ];
}

/**
 * Config names of the volunteer-board fields, storages before fields.
 */
function _makehaven_tasks_volunteer_field_config_names(): array {
  $names = [];
  $fields = ['stage', 'type', 'when', 'min_volunteers', 'max_volunteers', 'decide_by', 'decision_note', 'interest',
    // Tabling (update 9008).
    'event_url', 'organizer', 'rsvp_by', 'org_status', 'fee', 'selling_ok', 'bring',
  ];
  foreach ($fields as $field) {
    $names[] = 'field.storage.node.field_task_' . $field;
  }
  foreach ($fields as $field) {
    $names[] = 'field.field.node.task.field_task_' . $field;
  }
  return $names;
}

/**
 * Creates the volunteer-board fields and the sign-up table if missing.
 *
 * Each field is created from the site's config sync directory when it holds
 * that object (so the UUID matches and a later `drush cim` sees no change,
 * rather than a delete-and-recreate that would drop the field's data), and
 * from the module's config/optional copy otherwise.
 *
 * @return string[]
 *   The config names created.
 */
function _makehaven_tasks_install_volunteer_fields(): array {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('makehaven_task_signup')) {
    $schema->createTable('makehaven_task_signup', makehaven_tasks_schema()['makehaven_task_signup']);
  }

  $module_storage = new FileStorage(\Drupal::service('extension.list.module')->getPath('makehaven_tasks') . '/config/optional');
  $sync_storage = NULL;
  try {
    $sync_storage = \Drupal::service('config.storage.sync');
  }
  catch (\Throwable $e) {
    // No sync directory (tests); fall back to the module copy.
  }

  $created = [];
  $etm = \Drupal::entityTypeManager();
  foreach (_makehaven_tasks_volunteer_field_config_names() as $name) {
    $is_storage = str_starts_with($name, 'field.storage.');
    $entity_type = $is_storage ? 'field_storage_config' : 'field_config';
    $id = $is_storage ? substr($name, strlen('field.storage.')) : substr($name, strlen('field.field.'));
    $storage = $etm->getStorage($entity_type);
    if ($storage->load($id)) {
      continue;
    }
    $data = ($sync_storage && $sync_storage->exists($name)) ? $sync_storage->read($name) : $module_storage->read($name);
    if (!$data) {
      continue;
    }
    unset($data['_core']);
    // Each field save rebuilds field caches, which CiviCRM hooks make slow
    // (about 10 s each locally): restart the clock per object so 16 of them
    // cannot hit a 120 s max_execution_time mid-update.
    \Drupal\Component\Utility\Environment::setTimeLimit(120);
    $storage->createFromStorageRecord($data)->save();
    $created[] = $name;
  }
  return $created;
}

/**
 * Phase 1 enhancements: add category, biennial frequency, instructions, video.
 *
 * Adds:
 *   - field_task_category (list_string)
 *   - field_task_instructions (text_long)
 *   - field_task_video_url (link)
 *   - biennial value to field_task_frequency allowed values
 */
function makehaven_tasks_update_9001() {
  // 1. Add biennial to field_task_frequency allowed values.
  // The allowed_values setting is a flat key => label array.
  $frequency_storage = FieldStorageConfig::loadByName('node', 'field_task_frequency');
  if ($frequency_storage && !isset($frequency_storage->getSetting('allowed_values')['biennial'])) {
    $allowed_values = $frequency_storage->getSetting('allowed_values');
    // Insert biennial before 'archive' if present, otherwise append.
    if (array_key_exists('archive', $allowed_values)) {
      $new_values = [];
      foreach ($allowed_values as $key => $label) {
        if ($key === 'archive') {
          $new_values['biennial'] = 'Biennial (every 2 years)';
        }
        $new_values[$key] = $label;
      }
      $allowed_values = $new_values;
    }
    else {
      $allowed_values['biennial'] = 'Biennial (every 2 years)';
    }
    $frequency_storage->setSetting('allowed_values', $allowed_values);
    $frequency_storage->save();
  }

  // 2. Add field_task_category.
  if (!FieldStorageConfig::loadByName('node', 'field_task_category')) {
    FieldStorageConfig::create([
      'field_name' => 'field_task_category',
      'entity_type' => 'node',
      'type' => 'list_string',
      'settings' => [
        'allowed_values' => [
          'cleaning' => 'Cleaning',
          'maintenance' => 'Maintenance',
          'inspection' => 'Inspection',
          'restocking' => 'Restocking',
          'other' => 'Other',
        ],
      ],
      'cardinality' => 1,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'task', 'field_task_category')) {
    FieldConfig::create([
      'field_name' => 'field_task_category',
      'entity_type' => 'node',
      'bundle' => 'task',
      'label' => 'Category',
      'required' => FALSE,
    ])->save();

    // Add to default form display.
    $form_display = \Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->load('node.task.default');
    if ($form_display) {
      $form_display->setComponent('field_task_category', [
        'type' => 'options_select',
        'weight' => 5,
      ])->save();
    }

    // Add to default view display.
    $view_display = \Drupal::entityTypeManager()
      ->getStorage('entity_view_display')
      ->load('node.task.default');
    if ($view_display) {
      $view_display->setComponent('field_task_category', [
        'type' => 'list_default',
        'label' => 'inline',
        'weight' => 5,
      ])->save();
    }
  }

  // 3. Add field_task_instructions (rich text).
  if (!FieldStorageConfig::loadByName('node', 'field_task_instructions')) {
    FieldStorageConfig::create([
      'field_name' => 'field_task_instructions',
      'entity_type' => 'node',
      'type' => 'text_long',
      'cardinality' => 1,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'task', 'field_task_instructions')) {
    FieldConfig::create([
      'field_name' => 'field_task_instructions',
      'entity_type' => 'node',
      'bundle' => 'task',
      'label' => 'Instructions',
      'required' => FALSE,
      'description' => 'Step-by-step procedure, supply locations, and safety notes. Set on the template; displayed on each occurrence.',
    ])->save();

    $form_display = \Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->load('node.task.default');
    if ($form_display) {
      $form_display->setComponent('field_task_instructions', [
        'type' => 'text_textarea',
        'weight' => 10,
        'settings' => ['rows' => 6],
      ])->save();
    }

    $view_display = \Drupal::entityTypeManager()
      ->getStorage('entity_view_display')
      ->load('node.task.default');
    if ($view_display) {
      $view_display->setComponent('field_task_instructions', [
        'type' => 'text_default',
        'label' => 'above',
        'weight' => 10,
      ])->save();
    }
  }

  // 4. Add field_task_video_url (link field).
  if (!FieldStorageConfig::loadByName('node', 'field_task_video_url')) {
    FieldStorageConfig::create([
      'field_name' => 'field_task_video_url',
      'entity_type' => 'node',
      'type' => 'link',
      'cardinality' => 1,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'task', 'field_task_video_url')) {
    FieldConfig::create([
      'field_name' => 'field_task_video_url',
      'entity_type' => 'node',
      'bundle' => 'task',
      'label' => 'Instructional Video',
      'required' => FALSE,
      'description' => 'Optional link to a tutorial or how-to video for this task.',
      'settings' => [
        'link_type' => \Drupal\link\LinkItemInterface::LINK_EXTERNAL,
        'title' => DRUPAL_OPTIONAL,
      ],
    ])->save();

    $form_display = \Drupal::entityTypeManager()
      ->getStorage('entity_form_display')
      ->load('node.task.default');
    if ($form_display) {
      $form_display->setComponent('field_task_video_url', [
        'type' => 'link_default',
        'weight' => 11,
        'settings' => ['placeholder_url' => 'https://...', 'placeholder_title' => ''],
      ])->save();
    }

    $view_display = \Drupal::entityTypeManager()
      ->getStorage('entity_view_display')
      ->load('node.task.default');
    if ($view_display) {
      $view_display->setComponent('field_task_video_url', [
        'type' => 'link',
        'label' => 'above',
        'weight' => 11,
        'settings' => [
          'trim_length' => 80,
          'url_only' => FALSE,
          'url_plain' => FALSE,
          'rel' => '',
          'target' => '_blank',
        ],
      ])->save();
    }
  }

  return t('Phase 1: Added task category, biennial frequency, instructions, and video URL fields.');
}

